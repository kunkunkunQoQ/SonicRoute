     @Override
+    public void requestResize(int width, int height) {
+        if (width < 240 || height < 240 || width > 8192 || height > 8192) return;
+        synchronized (resizeLock) {
+            VirtualDisplay owned = virtualDisplay;
+            if (owned == null || owned.getDisplay().getDisplayId() <= 0) return;
+            if (requestedWidth == width && requestedHeight == height) return;
+            try {
+                // Resize the real owned display. DisplaySizeMonitor waits for the OS-reported
+                // size, then resets the encoder; start() publishes its matching PositionMapper.
+                owned.resize(width, height, dpi);
+                requestedWidth = width; requestedHeight = height;
+                Ln.d("Owned virtual display resize requested: " + width + "x" + height);
+            } catch (RuntimeException e) {
+                Ln.w("Could not resize owned virtual display", e);
+            }
+        }
+    }
+
