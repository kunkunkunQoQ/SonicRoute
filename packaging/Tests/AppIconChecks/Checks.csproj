<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0-windows;net8.0-windows;net48</TargetFrameworks>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>../../../SonicRoute/SonicRoute.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../SonicRoute/AppIconService.cs" Link="AppIconService.cs" />
  </ItemGroup>
</Project>
