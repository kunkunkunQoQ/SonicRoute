<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><PanelTestFramework Condition="'$(PanelTestFramework)' == ''">net10.0-windows</PanelTestFramework>
    <TargetFramework>$(PanelTestFramework)</TargetFramework><UseWPF>true</UseWPF>
    <AssemblyName>PanelRemovalChecks</AssemblyName><PlatformTarget>x64</PlatformTarget><LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <ProjectReference Include="../../../SonicRoute/SonicRoute.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <ProjectReference Include="../../../SonicRoute.Legacy/SonicRoute.Legacy.csproj" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../../SonicRoute/App.xaml" LogicalName="ProductApp.xaml" /></ItemGroup>
</Project>
