<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFrameworks>net10.0-windows;net8.0-windows;net48</TargetFrameworks><UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget><LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../SonicRoute.Core/SonicRoute.Core.csproj" />
    <Compile Include="../../../SonicRoute/AutoRuleService.cs;../../../SonicRoute/ExecutionHistoryRun.cs;../../../SonicRoute/CurrentAppService.cs" />
    <Compile Include="../../../SonicRoute/HotkeyActions.cs" />
  </ItemGroup>
  <Target Name="PrepareHotkeyBoundary" BeforeTargets="CoreCompile">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/Prepare-Hotkeys.ps1&quot; -OutputDirectory &quot;$(MSBuildProjectDirectory)/obj/hotkeys/$(TargetFramework)&quot;" />
    <ItemGroup><Compile Include="$(MSBuildProjectDirectory)/obj/hotkeys/$(TargetFramework)/*.cs" /></ItemGroup>
  </Target>
</Project>
