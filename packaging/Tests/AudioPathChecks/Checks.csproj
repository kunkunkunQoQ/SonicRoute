<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0-windows;net8.0-windows;net48</TargetFrameworks>
    <AssemblyName>AudioPathChecks</AssemblyName>
    <PlatformTarget>x64</PlatformTarget><LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SourceRoot Condition="'$(SourceRoot)' == ''">$(MSBuildProjectDirectory)/../../..</SourceRoot>
    <DefineConstants Condition="'$(BaselineRevision)' != ''">$(DefineConstants);BASELINE</DefineConstants>
  </PropertyGroup>
  <ItemGroup><Compile Include="Program.cs;Fakes.cs;TuningChecks.cs;InputStateChecks.cs;PanelSnapshotChecks.cs;AbcdeChecks.cs" /></ItemGroup>
  <Target Name="PrepareAudioSources" BeforeTargets="CoreCompile">
    <PropertyGroup><PreparedSources Condition="'$(PreparedSources)' == ''">$(IntermediateOutputPath)prepared/$(BaselineRevision)</PreparedSources></PropertyGroup>
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/Prepare-Sources.ps1&quot; -SourceRoot &quot;$(SourceRoot)&quot; -OutputDirectory &quot;$(PreparedSources)&quot; -Revision &quot;$(BaselineRevision)&quot;" />
    <ItemGroup><Compile Include="$(PreparedSources)/*.cs" /></ItemGroup>
  </Target>
</Project>
