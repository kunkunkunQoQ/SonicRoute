<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFrameworks>net10.0-windows;net8.0-windows;net48</TargetFrameworks>
    <PlatformTarget>x64</PlatformTarget><LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects><GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../SonicRoute.Core/SonicRoute.Core.csproj" />
    <Compile Include="../../../SonicRoute/L10n.cs;../../../SonicRoute/LanguageFiles.cs;../../../SonicRoute/LanguageJsonContext.cs" />
    <EmbeddedResource Include="../../../SonicRoute/Resources/Lang/*.json" LogicalName="SonicRoute.Resources.Lang.%(Filename).json" />
  </ItemGroup>
</Project>
