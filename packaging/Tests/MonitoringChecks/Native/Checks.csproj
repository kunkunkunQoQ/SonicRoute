<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFrameworks>net10.0-windows;net8.0-windows;net48</TargetFrameworks>
    <AssemblyName>MonitoringNativeChecks</AssemblyName><StartupObject>MonitoringNativeChecks.Program</StartupObject>
    <PlatformTarget>x64</PlatformTarget><LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects><GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;../../AudioPathChecks/NativeProgram.cs" />
    <ProjectReference Include="../../../../SonicRoute.Core/SonicRoute.Core.csproj" />
  </ItemGroup>
  <Target Name="PrepareNativeObserver" BeforeTargets="CoreCompile">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/Prepare.ps1&quot; -OutputDirectory &quot;$(MSBuildProjectDirectory)/obj/prepared/$(TargetFramework)&quot;" />
    <ItemGroup><Compile Include="$(MSBuildProjectDirectory)/obj/prepared/$(TargetFramework)/*.cs" /></ItemGroup>
  </Target>
</Project>
