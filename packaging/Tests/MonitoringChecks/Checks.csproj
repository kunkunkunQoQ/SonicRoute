<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFrameworks>net10.0-windows;net8.0-windows;net48</TargetFrameworks>
    <AssemblyName>MonitoringChecks</AssemblyName><PlatformTarget>x64</PlatformTarget><LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup><Compile Include="Program.cs;Fakes.cs" /></ItemGroup>
  <Target Name="PrepareMonitoringSources" BeforeTargets="CoreCompile">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/Prepare-Sources.ps1&quot; -OutputDirectory &quot;$(MSBuildProjectDirectory)/obj/prepared/$(TargetFramework)&quot;" />
    <ItemGroup><Compile Include="$(MSBuildProjectDirectory)/obj/prepared/$(TargetFramework)/*.cs" /></ItemGroup>
  </Target>
</Project>
