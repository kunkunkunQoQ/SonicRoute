<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../build/Version.props" />
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net8.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CsWinRTEmbedded>true</CsWinRTEmbedded>
    <CsWinRTWindowsMetadata Condition="'$(CsWinRTWindowsMetadata)' == '' and Exists('C:\Program Files (x86)\Windows Kits\10\Platforms\UAP\10.0.22621.0\Platform.xml')">10.0.22621.0</CsWinRTWindowsMetadata>
    <CsWinRTWindowsMetadata Condition="'$(CsWinRTWindowsMetadata)' == '' and Exists('C:\Program Files (x86)\Windows Kits\10\Platforms\UAP\10.0.26100.0\Platform.xml')">10.0.26100.0</CsWinRTWindowsMetadata>
    <CsWinRTWindowsMetadata Condition="'$(CsWinRTWindowsMetadata)' == '' and Exists('C:\Program Files (x86)\Windows Kits\10\Platforms\UAP\10.0.22000.0\Platform.xml')">10.0.22000.0</CsWinRTWindowsMetadata>
    <CsWinRTWindowsMetadata Condition="'$(CsWinRTWindowsMetadata)' == '' and Exists('C:\Program Files (x86)\Windows Kits\10\Platforms\UAP\10.0.20348.0\Platform.xml')">10.0.20348.0</CsWinRTWindowsMetadata>
    <CsWinRTWindowsMetadata Condition="'$(CsWinRTWindowsMetadata)' == '' and Exists('C:\Program Files (x86)\Windows Kits\10\Platforms\UAP\10.0.19041.0\Platform.xml')">10.0.19041.0</CsWinRTWindowsMetadata>
    <CsWinRTWindowsMetadata Condition="'$(CsWinRTWindowsMetadata)' == ''">10.0.22621.0</CsWinRTWindowsMetadata>
    <CsWinRTIncludes>Windows.ApplicationModel.StartupTask;Windows.ApplicationModel.IStartupTask;Windows.Foundation</CsWinRTIncludes>
    <CsWinRTExcludes>Windows;Microsoft;Windows.Foundation.Diagnostics;Windows.Foundation.Numerics;Windows.Foundation.PropertyType</CsWinRTExcludes>
    <AssemblyName>SonicRoute.StoreInterop</AssemblyName>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" PrivateAssets="all" /></ItemGroup>
  <!-- cswinrt 2.x response files mishandle non-ASCII output paths. Relative output keeps
       a fresh build reproducible after the experiment moves into a Chinese directory. -->
  <Target Name="UseRelativeEmbeddedProjectionPath" BeforeTargets="CsWinRTGenerateProjection" DependsOnTargets="CsWinRTPrepareProjection">
    <ItemGroup>
      <StartupProjectionExclude Include="$(CsWinRTExcludes)" />
      <StartupProjectionInclude Include="$(CsWinRTIncludes)" />
    </ItemGroup>
    <PropertyGroup>
      <CsWinRTParams>
-target $(CsWinRTExeTFM)
-input $(CsWinRTWindowsMetadata)
-output "$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)', '$(CsWinRTGeneratedFilesDir.TrimEnd('\'))'))"
@(StartupProjectionExclude->'-exclude %(Identity)', '&#x0d;&#x0a;')
@(StartupProjectionInclude->'-include %(Identity)', '&#x0d;&#x0a;')
-embedded
      </CsWinRTParams>
    </PropertyGroup>
  </Target>
  <!-- CsWinRT 2.3.1 embedded targets hardcode lib\net8.0\WinRT.Runtime.dll removal. On net10.0,
       NuGet selects net9.0\WinRT.Runtime.dll causing duplicate definitions with embedded sources. -->
  <Target Name="FixCsWinRTRuntimeReferenceForNet10" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <Reference Remove="WinRT.Runtime" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="'%(FileName)' == 'WinRT.Runtime'" />
      <ResolvedCompileFileDefinitions Remove="@(ResolvedCompileFileDefinitions)" Condition="'%(FileName)' == 'WinRT.Runtime'" />
    </ItemGroup>
  </Target>
</Project>
