<UserControl x:Class="SonicRoute.AirPlayReceiverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SonicRoute">
    <StackPanel>
        <TextBlock Text="{Binding [Phone.AirPlayTitle], Source={x:Static local:L10n.Instance}}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Theme.TextPrimary}" FontSize="14" FontWeight="SemiBold"/>
        <TextBlock x:Name="AirPlayStatusText" Foreground="{DynamicResource Theme.TextSecondary}"
                   FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Text="{Binding [Phone.AirPlaySteps], Source={x:Static local:L10n.Instance}}"
                   Foreground="{DynamicResource Theme.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,10"/>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding [Phone.StreamVideoLabel], Source={x:Static local:L10n.Instance}}" FontSize="11"
                       Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="MirrorDecoder" Grid.Column="1" MinHeight="28" FontSize="11"
                      Style="{StaticResource RoundedComboBox}" SelectionChanged="Decoder_Changed"
                      AutomationProperties.Name="{Binding [Phone.StreamDecoder], Source={x:Static local:L10n.Instance}}"/>
        </Grid>
        <Button x:Name="ShowMirror" MinHeight="32" FontSize="11" Click="ShowMirror_Click" Margin="0,0,0,5"
                Visibility="Collapsed" Style="{StaticResource QuickPanelToolButton}" Background="{DynamicResource Theme.Overlay}"
                Content="{Binding [Phone.AirPlayShowScreen], Source={x:Static local:L10n.Instance}}"/>
        <Button x:Name="AirPlayToggle" MinHeight="32" FontSize="11" Click="Toggle_Click"
                Style="{StaticResource QuickPanelToolButton}" Background="{DynamicResource Theme.Overlay}"/>
    </StackPanel>
</UserControl>
