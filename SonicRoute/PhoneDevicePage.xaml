<UserControl x:Class="SonicRoute.PhoneDevicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SonicRoute"
             IsVisibleChanged="PairingVisibilityChanged" Loaded="PairingLoaded" Unloaded="PairingUnloaded">
    <UserControl.Resources>
        <Style x:Key="PhoneCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
        </Style>
        <Style x:Key="PhoneHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="PhoneCommandButton" TargetType="Button" BasedOn="{StaticResource QuickPanelToolButton}">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBg}"/>
            <Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="ReceiveToComputerButton" TargetType="Button" BasedOn="{StaticResource PhoneCommandButton}">
            <Setter Property="Padding" Value="14,5"/><Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Accent}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.AccentIconInk}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PhoneDeviceActionButton" TargetType="Button" BasedOn="{StaticResource PhoneCommandButton}">
            <Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="MinHeight" Value="30"/><Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="PhonePinButton" TargetType="Button" BasedOn="{StaticResource QuickPanelToolButton}">
            <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
        </Style>
        <Style x:Key="PhonePinGraphic" TargetType="Viewbox">
            <Setter Property="Width" Value="14"/><Setter Property="Height" Value="16"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Style.Triggers><DataTrigger Binding="{Binding Retained}" Value="True">
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="45"/></Setter.Value></Setter>
            </DataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="PhoneLibraryItem">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Width="34" Height="34" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Item.Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                    <Image Source="{Binding Item.Icon}"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,8,0">
                    <TextBlock Foreground="{DynamicResource Theme.TextPrimary}" Text="{Binding Item.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Item.Description}" Style="{StaticResource PhoneHint}" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Tag="{Binding Item.App}" Style="{StaticResource PhonePinButton}" Click="RetainApp_Click" ToolTip="{Binding ActionText}" AutomationProperties.Name="{Binding ActionText}">
                        <Viewbox Style="{StaticResource PhonePinGraphic}"><Path Data="{x:Static local:AutomationIcons.Pin}" Fill="{DynamicResource Theme.Accent}"/></Viewbox>
                    </Button>
                    <CheckBox IsChecked="{Binding SmartVolume, Mode=OneWay}" Style="{DynamicResource AutomationSwitch}"
                              Width="34" Margin="8,0,0,0" VerticalAlignment="Center" Checked="SmartVolume_Changed" Unchecked="SmartVolume_Changed"
                              ToolTip="{Binding [Phone.SmartVolumeTitle], Source={x:Static local:L10n.Instance}}" AutomationProperties.Name="{Binding [Phone.SmartVolumeTitle], Source={x:Static local:L10n.Instance}}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="EncoderOptionTemplate">
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Style="{x:Null}"/>
        </DataTemplate>
        <Style x:Key="StreamOptionItem" TargetType="ComboBoxItem" BasedOn="{StaticResource RoundedComboItem}">
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
        </Style>
        <Style x:Key="AndroidFileRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
            <Setter Property="ToolTip" Value="{Binding Label}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Row" Margin="2,1" CornerRadius="6" BorderThickness="1"
                                    Background="Transparent" BorderBrush="Transparent" Padding="9,0">
                                <Grid MinHeight="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Icon" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left"
                                          Data="{x:Static local:AutomationIcons.File}" Stroke="{DynamicResource Theme.TextSecondary}"
                                          StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" FontSize="13" Margin="2,0,7,0"/>
                                    <TextBlock Grid.Column="2" x:Name="Size" Text="{Binding SizeText}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Theme.TextSecondary}" FontSize="11" Margin="2,0,6,0"/>
                                    <Border Grid.Column="3" x:Name="CheckBox" Width="15" Height="15" CornerRadius="4"
                                            BorderThickness="1" BorderBrush="{DynamicResource Theme.Border}" HorizontalAlignment="Right">
                                        <Path x:Name="Check" Visibility="Hidden" Data="M2,6 L5,9 L11,3" Stretch="Uniform"
                                              Margin="2" Stroke="{DynamicResource Theme.AccentIconInk}" StrokeThickness="1.6"/>
                                    </Border>
                                    <Path x:Name="Next" Grid.Column="3" Visibility="Collapsed" Width="5" Height="9"
                                          HorizontalAlignment="Right" Margin="0,0,4,0" Data="M1,1 L5,5 L1,9"
                                          Stretch="Fill" Stroke="{DynamicResource Theme.TextSecondary}" StrokeThickness="1.4"/>
                                </Grid>
                            </Border>
                            <Button x:Name="OpenFolder" Visibility="Collapsed" Focusable="False"
                                    AutomationProperties.Name="{Binding Label}" Cursor="Hand" Click="AndroidFolder_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"/></ControlTemplate></Button.Template>
                            </Button>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Theme.NavHover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Theme.Overlay}"/>
                                <Setter TargetName="CheckBox" Property="Background" Value="{DynamicResource Theme.Accent}"/>
                                <Setter TargetName="CheckBox" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/></Trigger>
                            <DataTrigger Binding="{Binding Directory}" Value="True">
                                <Setter TargetName="Icon" Property="Data" Value="M2,6 Q2,4 4,4 H9 L12,7 H20 Q22,7 22,9 V18 Q22,20 20,20 H4 Q2,20 2,18 Z"/>
                                <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Theme.TextPrimary}"/>
                                <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Theme.Overlay}"/>
                                <Setter TargetName="CheckBox" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Size" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Next" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="OpenFolder" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="DeviceScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2,0,4,0">
            <Border Style="{StaticResource PhoneCard}" x:Name="DeviceCard">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource Theme.Overlay}" CornerRadius="10" Width="38" Height="48" HorizontalAlignment="Left">
                            <Viewbox Width="22" Height="32"><Path Data="{x:Static local:AutomationIcons.Phone}" Stroke="{DynamicResource Theme.TextSecondary}" StrokeThickness="1.5"/></Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Grid>
                                <Grid.Style><Style TargetType="Grid">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=PhoneNameBox}" Value="Visible"><Setter Property="HorizontalAlignment" Value="Stretch"/></DataTrigger></Style.Triggers>
                                </Style></Grid.Style>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="DeviceName" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=PhoneNameBox}" Value="Visible"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="PhoneNameBox" Visibility="Collapsed" MaxLength="64" FontSize="16" FontWeight="SemiBold" Padding="4,0"
                                         TextChanged="Name_TextChanged" KeyDown="Name_KeyDown" LostKeyboardFocus="Name_LostFocus" AutomationProperties.Name="{Binding [Phone.DeviceNameAutomation], Source={x:Static local:L10n.Instance}}"/>
                                <Button x:Name="RenameButton" Grid.Column="1" Style="{StaticResource GhostButton}" Width="26" Height="26" Margin="6,0,0,0"
                                        VerticalAlignment="Center" Click="Rename_Click" AutomationProperties.Name="{Binding [Phone.RenamePhoneAutomation], Source={x:Static local:L10n.Instance}}">
                                    <Viewbox Width="14" Height="14"><Path Data="{x:Static local:AutomationIcons.Edit}" Width="24" Height="24" Stroke="{DynamicResource Theme.TextSecondary}"
                                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="DeviceDescription" Style="{StaticResource PhoneHint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,4,8,0"/>
                        </StackPanel>
                        <StackPanel x:Name="DeviceCommands" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Button x:Name="ReconnectButton" Content="{Binding [Phone.Reconnect], Source={x:Static local:L10n.Instance}}" Style="{StaticResource PhoneDeviceActionButton}" Click="Reconnect_Click"/>
                            <Button x:Name="DisconnectButton" Content="{Binding [Phone.Disconnect], Source={x:Static local:L10n.Instance}}" Style="{StaticResource PhoneDeviceActionButton}" Click="Disconnect_Click"/>
                            <Button x:Name="UnpairButton" Content="{Binding [Phone.Unpair], Source={x:Static local:L10n.Instance}}" Style="{StaticResource PhoneDeviceActionButton}" Click="Unpair_Click"/>
                            <Button x:Name="RemoveDeviceButton" Content="{Binding [Phone.DeleteDevice], Source={x:Static local:L10n.Instance}}" Style="{StaticResource PhoneDeviceActionButton}" Margin="0" Click="RemoveDevice_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border x:Name="StreamingCard" Style="{StaticResource PhoneCard}" IsVisibleChanged="StreamingVisibilityChanged"
                    ToolTip="{Binding [Phone.StreamApplyHint], Source={x:Static local:L10n.Instance}}">
                <Grid TextElement.FontSize="11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="80"/>
                        <ColumnDefinition Width="*" MinWidth="80"/>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding [Phone.StreamAudioLabel], Source={x:Static local:L10n.Instance}}"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <ComboBox x:Name="AudioEncoderCombo" Grid.Column="1" Style="{StaticResource RoundedComboBox}"
                              ItemTemplate="{StaticResource EncoderOptionTemplate}"
                              ItemContainerStyle="{StaticResource StreamOptionItem}"
                              Height="28" FontSize="11" Margin="0,0,8,6"
                              ToolTip="{Binding [Phone.StreamEncoder], Source={x:Static local:L10n.Instance}}"
                              AutomationProperties.Name="{Binding [Phone.StreamEncoder], Source={x:Static local:L10n.Instance}}"
                              DropDownOpened="StreamEncoder_DropDownOpened" SelectionChanged="StreamSettings_Changed"/>
                    <ComboBox x:Name="AudioDecoderCombo" Grid.Column="2" Style="{StaticResource RoundedComboBox}"
                              ItemTemplate="{StaticResource EncoderOptionTemplate}"
                              Height="28" FontSize="11" Margin="0,0,8,6"
                              ToolTip="{Binding [Phone.StreamDecoder], Source={x:Static local:L10n.Instance}}"
                              AutomationProperties.Name="{Binding [Phone.StreamDecoder], Source={x:Static local:L10n.Instance}}"
                              SelectionChanged="StreamSettings_Changed"/>
                    <ComboBox x:Name="AudioBitRateCombo" Grid.Column="3" Style="{StaticResource RoundedComboBox}"
                              ToolTip="{Binding [Phone.StreamBitRate], Source={x:Static local:L10n.Instance}}"
                              Height="28" FontSize="11" Margin="0,0,8,6" SelectionChanged="StreamSettings_Changed"/>

                    <TextBlock Grid.Row="1" Text="{Binding [Phone.StreamVideoLabel], Source={x:Static local:L10n.Instance}}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="VideoEncoderCombo" Grid.Row="1" Grid.Column="1" Style="{StaticResource RoundedComboBox}"
                              ItemTemplate="{StaticResource EncoderOptionTemplate}"
                              ItemContainerStyle="{StaticResource StreamOptionItem}"
                              Height="28" FontSize="11" Margin="0,0,8,0"
                              ToolTip="{Binding [Phone.StreamEncoder], Source={x:Static local:L10n.Instance}}"
                              AutomationProperties.Name="{Binding [Phone.StreamEncoder], Source={x:Static local:L10n.Instance}}"
                              DropDownOpened="StreamEncoder_DropDownOpened" SelectionChanged="StreamSettings_Changed"/>
                    <ComboBox x:Name="VideoDecoderCombo" Grid.Row="1" Grid.Column="2" Style="{StaticResource RoundedComboBox}"
                              ItemTemplate="{StaticResource EncoderOptionTemplate}"
                              ItemContainerStyle="{StaticResource StreamOptionItem}"
                              Height="28" FontSize="11" Margin="0,0,8,0"
                              ToolTip="{Binding [Phone.StreamDecoder], Source={x:Static local:L10n.Instance}}"
                              AutomationProperties.Name="{Binding [Phone.StreamDecoder], Source={x:Static local:L10n.Instance}}"
                              SelectionChanged="StreamSettings_Changed"/>
                    <ComboBox x:Name="VideoBitRateCombo" Grid.Row="1" Grid.Column="3" Style="{StaticResource RoundedComboBox}"
                              ToolTip="{Binding [Phone.StreamBitRate], Source={x:Static local:L10n.Instance}}"
                              Height="28" FontSize="11" Margin="0,0,8,0" SelectionChanged="StreamSettings_Changed"/>
                    <ComboBox x:Name="VideoFpsCombo" Grid.Row="1" Grid.Column="4" Style="{StaticResource RoundedComboBox}"
                              ToolTip="{Binding [Phone.StreamFps], Source={x:Static local:L10n.Instance}}"
                              MinWidth="70" Height="28" FontSize="11" SelectionChanged="StreamSettings_Changed"/>
                </Grid>
            </Border>
            <StackPanel x:Name="RetainedPanel">
                <Border Style="{StaticResource PhoneCard}" Padding="12,10,12,8">
                    <StackPanel>
                        <Grid Margin="4,0,4,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [Phone.QuickPanelAppsTitle], Source={x:Static local:L10n.Instance}}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="RetainedCount" Grid.Column="1" Style="{StaticResource PhoneHint}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding [Phone.PinDesc], Source={x:Static local:L10n.Instance}}" Style="{StaticResource PhoneHint}" Margin="4,0,0,10"/>
                        <ItemsControl x:Name="RetainedApps" ItemTemplate="{StaticResource PhoneLibraryItem}"/>
                        <TextBlock x:Name="RetainedEmpty" Text="{Binding [Phone.RetainedEmptyHint], Source={x:Static local:L10n.Instance}}" Style="{StaticResource PhoneHint}" Margin="0,12"/>
                    </StackPanel>
                </Border>
                <Button x:Name="AddAppsButton" Content="{Binding [Phone.AddQuickPanelAppButton], Source={x:Static local:L10n.Instance}}" Style="{StaticResource QuickPanelToolButton}" Background="{DynamicResource Theme.Overlay}" Height="38" Margin="0,0,0,12" Click="AddApps_Click"/>
                <Border x:Name="FileTransferCard" Style="{StaticResource PhoneCard}" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel x:Name="AndroidFilePicker" Visibility="Collapsed" PreviewKeyDown="AndroidFilePicker_KeyDown">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button x:Name="AndroidFileUp" Style="{StaticResource PhoneCommandButton}" Width="32" Height="32" Padding="0" Margin="0,0,7,0"
                                        AutomationProperties.Name="{Binding [Phone.AndroidParentFolder], Source={x:Static local:L10n.Instance}}"
                                        ToolTip="{Binding [Phone.AndroidParentFolder], Source={x:Static local:L10n.Instance}}" Click="AndroidFileUp_Click">
                                    <Path Data="M9,2 L3,8 L9,14 M3,8 H16" Width="14" Height="13" Stretch="Uniform"
                                          Stroke="{DynamicResource Theme.TextPrimary}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                </Button>
                                <TextBlock Grid.Column="1" x:Name="AndroidFilePath" VerticalAlignment="Center" FontSize="14"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                <Button x:Name="AndroidFileCancel" Grid.Column="2" Style="{StaticResource PhoneCommandButton}"
                                        Width="32" Height="32" Padding="0" Margin="0" Background="Transparent" BorderBrush="Transparent"
                                        AutomationProperties.Name="{Binding [Phone.FileClose], Source={x:Static local:L10n.Instance}}"
                                        ToolTip="{Binding [Phone.FileClose], Source={x:Static local:L10n.Instance}}" Click="AndroidFileCancel_Click">
                                    <Path Data="M2,2 L12,12 M12,2 L2,12" Width="11" Height="11" Stretch="Uniform"
                                          Stroke="{DynamicResource Theme.TextSecondary}" StrokeThickness="1.5"/>
                                </Button>
                            </Grid>
                            <Border BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="8" Padding="2"
                                    Background="{DynamicResource Theme.SurfaceBg}">
                                <Grid MinHeight="84">
                                    <ListBox x:Name="AndroidFileEntries" MaxHeight="260" BorderThickness="0" Background="Transparent"
                                             AutomationProperties.LabeledBy="{Binding ElementName=AndroidFilePath}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling"
                                             TextSearch.TextPath="Label" SelectionMode="Multiple" ItemContainerStyle="{StaticResource AndroidFileRow}"
                                             SelectionChanged="AndroidFileSelection_Changed" PreviewKeyDown="AndroidFileEntries_KeyDown"/>
                                    <TextBlock x:Name="AndroidFileEmpty" Style="{StaticResource PhoneHint}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Margin="10" TextAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <Button x:Name="AndroidFileGet" Style="{StaticResource ReceiveToComputerButton}" HorizontalAlignment="Right"
                                    Click="AndroidFileGet_Click" Margin="0,9,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel"><Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=AndroidFilePicker}" Value="Visible"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers></Style>
                            </StackPanel.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding [Phone.Files], Source={x:Static local:L10n.Instance}}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button x:Name="AndroidBrowseFiles" Grid.Column="1" Style="{StaticResource PhoneCommandButton}"
                                        AutomationProperties.Name="{Binding [Phone.AndroidBrowseFiles], Source={x:Static local:L10n.Instance}}"
                                        Margin="6,0,0,0" MinHeight="30" Padding="10,4" FontSize="12" Click="AndroidBrowseFiles_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="13" Height="13" Data="M8,1 V10 M4,6 L8,10 L12,6 M2,12 V15 H14 V12"
                                              Stretch="Uniform" Stroke="{DynamicResource Theme.TextPrimary}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                        <TextBlock Text="{Binding [Phone.AndroidBrowseFiles], Source={x:Static local:L10n.Instance}}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Button x:Name="SendFileButton" Margin="0,10,0,0" MinHeight="104" Padding="12,10"
                                    Opacity="1" AllowDrop="True" AutomationProperties.Name="{Binding Text, ElementName=FileDropLabel}"
                                    PreviewDragOver="File_DragOver" PreviewDragLeave="File_DragLeave"
                                    PreviewDrop="File_Drop" Click="SendFile_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PhoneCommandButton}">
                                        <Setter Property="Background" Value="{DynamicResource Theme.Overlay}"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource Theme.WindowBg}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel>
                                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center"
                                               Foreground="{Binding Foreground, ElementName=SendFileButton}" FontSize="22"/>
                                    <TextBlock x:Name="FileDropLabel" Margin="0,8,0,0" TextAlignment="Center"
                                               Foreground="{Binding Foreground, ElementName=SendFileButton}" FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="FileStatus" Style="{StaticResource PhoneHint}" Margin="0,6,0,0"
                                       Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                            <Grid x:Name="FileProgressRow" Visibility="Collapsed" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ProgressBar x:Name="FileProgress" Height="4" Maximum="1" VerticalAlignment="Center"
                                             Foreground="{DynamicResource Theme.Accent}"/>
                                <Button Grid.Column="1" Style="{StaticResource PhoneCommandButton}" Margin="10,0,0,0" Click="CancelFile_Click"
                                        Content="{Binding [Auto.Cancel], Source={x:Static local:L10n.Instance}}"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource PhoneHint}" FontSize="11" VerticalAlignment="Center" Margin="0,0,9,0"
                                           Text="{Binding [Phone.AndroidReceiveFolder], Source={x:Static local:L10n.Instance}}"/>
                                <TextBlock x:Name="AndroidReceivePath" Grid.Column="1" Style="{StaticResource PhoneHint}" FontSize="11"
                                           Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <Button x:Name="AndroidChangeFolder" Grid.Column="2" Style="{StaticResource PhoneCommandButton}" Margin="6,0,0,0"
                                        Background="Transparent" BorderBrush="Transparent" FontSize="11"
                                        Content="{Binding [Phone.FileChangeFolder], Source={x:Static local:L10n.Instance}}" Click="AndroidChangeFolder_Click"/>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding [Phone.FileReceiveFolder], Source={x:Static local:L10n.Instance}}"
                                           Style="{StaticResource PhoneHint}" FontSize="11" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock x:Name="LocalReceiveFolderPath" Grid.Column="1" Style="{StaticResource PhoneHint}"
                                           Foreground="{DynamicResource Theme.TextPrimary}" FontSize="11"
                                           VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <Button x:Name="ChangeLocalReceiveFolder" Grid.Column="2" Style="{StaticResource PhoneCommandButton}" Margin="6,0,0,0"
                                        Background="Transparent" BorderBrush="Transparent" FontSize="11"
                                        Content="{Binding [Phone.FileChangeFolder], Source={x:Static local:L10n.Instance}}" Click="LocalReceiveFolder_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="ClipboardCard" Style="{StaticResource PhoneCard}" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{Binding [Phone.ClipboardSyncTitle], Source={x:Static local:L10n.Instance}}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ClipboardStatus" AutomationProperties.LiveSetting="Polite" Text="{Binding [Phone.ClipboardDefaultHint], Source={x:Static local:L10n.Instance}}" Style="{StaticResource PhoneHint}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="ClipboardSyncToggle" Grid.Column="1" Style="{DynamicResource AutomationSwitch}" Width="34"
                                  VerticalAlignment="Center" AutomationProperties.HelpText="{Binding Text, ElementName=ClipboardStatus}" Checked="ClipboardSync_Changed" Unchecked="ClipboardSync_Changed" AutomationProperties.Name="{Binding [Phone.ClipboardEnableToggle], Source={x:Static local:L10n.Instance}}"/>
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel x:Name="ConnectionPanel" Visibility="Collapsed" IsVisibleChanged="PairingVisibilityChanged">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton x:Name="AndroidConnectionChoice" GroupName="PhoneConnection" Content="Android"
                                 IsChecked="True" Checked="ConnectionChoice_Changed"/>
                    <RadioButton x:Name="AirPlayConnectionChoice" GroupName="PhoneConnection" Content="AirPlay"
                                 Checked="ConnectionChoice_Changed"/>
                </StackPanel>
                <Border x:Name="AirPlayCard" Style="{StaticResource PhoneCard}" Visibility="Collapsed">
                    <local:AirPlayReceiverView x:Name="AirPlayConnectionView"/>
                </Border>
                <Border x:Name="PairingCard" Style="{StaticResource PhoneCard}">
                <Grid x:Name="PairMethodsGrid">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" MinWidth="182"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel x:Name="QrPairCard" Margin="0,0,16,0">
                        <TextBlock Text="{Binding [Phone.QrPairTitle], Source={x:Static local:L10n.Instance}}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [Phone.QrPairSteps], Source={x:Static local:L10n.Instance}}" Style="{StaticResource PhoneHint}" Margin="0,4,0,8"/>
                        <Button x:Name="QrButton" Style="{StaticResource QuickPanelToolButton}" Click="QrPair_Click"
                                HorizontalAlignment="Center" Width="166" Height="166" Padding="0" Margin="0"
                                AutomationProperties.Name="{Binding [Phone.QrRefreshHint], Source={x:Static local:L10n.Instance}}"
                                ToolTip="{Binding [Phone.QrRefreshHint], Source={x:Static local:L10n.Instance}}">
                            <Grid Width="164" Height="164" Background="White">
                                <TextBlock Text="{Binding [Phone.ProcessingStatus], Source={x:Static local:L10n.Instance}}"
                                           Foreground="#687080" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="PairQrImage" Width="164" Height="164" Visibility="Collapsed" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Grid>
                        </Button>
                        <TextBlock x:Name="QrStatus" Text="{Binding [Phone.QrRefreshHint], Source={x:Static local:L10n.Instance}}" Style="{StaticResource PhoneHint}" TextAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="CodePairCard" Grid.Column="1">
                        <TextBlock Text="{Binding [Phone.CodePairTitle], Source={x:Static local:L10n.Instance}}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [Phone.CodePairSteps], Source={x:Static local:L10n.Instance}}" Style="{StaticResource PhoneHint}" Margin="0,4,0,8"/>
                        <TextBlock Text="{Binding [Phone.PairingAddressLabel], Source={x:Static local:L10n.Instance}}" Margin="0,0,0,6"/>
                        <TextBox x:Name="PairAddressBox" Style="{StaticResource ModernTextBox}" AutomationProperties.Name="{Binding [Phone.PairingAddressAutomation], Source={x:Static local:L10n.Instance}}"/>
                        <TextBlock Text="{Binding [Phone.PairingCodeLabel], Source={x:Static local:L10n.Instance}}" Margin="0,8,0,6"/>
                        <TextBox x:Name="PairCodeBox" MaxLength="6" FontSize="18" FontFamily="Consolas" Style="{StaticResource ModernTextBox}" AutomationProperties.Name="{Binding [Phone.PairingCodeAutomation], Source={x:Static local:L10n.Instance}}"/>
                        <Button x:Name="PairButton" Content="{Binding [Phone.PairAndConnect], Source={x:Static local:L10n.Instance}}" Style="{StaticResource QuickPanelToolButton}" Background="{DynamicResource Theme.Overlay}" Margin="0,8,0,0" Click="PairCode_Click"/>
                    </StackPanel>
                </Grid>
                </Border>
                <Border x:Name="DirectConnectCard" Style="{StaticResource PhoneCard}" IsVisibleChanged="DirectConnect_VisibilityChanged">
                    <StackPanel>
                        <TextBlock Text="{Binding [Phone.DirectConnectTitle], Source={x:Static local:L10n.Instance}}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [Phone.DirectConnectDesc], Source={x:Static local:L10n.Instance}}" Style="{StaticResource PhoneHint}" Margin="0,4,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ConnectAddressBox" Style="{StaticResource ModernTextBox}" Height="32" AutomationProperties.Name="{Binding [Phone.ConnectAddressAutomation], Source={x:Static local:L10n.Instance}}"/>
                            <ComboBox x:Name="SavedConnectDevices" Style="{StaticResource RoundedComboBox}" Height="32" MaxDropDownHeight="230"
                                      Visibility="Collapsed" IsTextSearchEnabled="False" SelectionChanged="SavedConnectDevice_Changed"
                                      AutomationProperties.Name="{Binding [Phone.SavedConnectDevices], Source={x:Static local:L10n.Instance}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Label}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Connection}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="{Binding [Phone.ManualConnectAddress], Source={x:Static local:L10n.Instance}}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="SearchSavedDevicesButton" Grid.Column="1" Content="{Binding [Phone.SearchSavedDevices], Source={x:Static local:L10n.Instance}}"
                                    Style="{StaticResource PhoneCommandButton}" Height="32" Margin="8,0,0,0" Click="SearchSavedDevices_Click"/>
                            <Button x:Name="ConnectButton" Grid.Column="2" Content="{Binding [Phone.ConnectShort], Source={x:Static local:L10n.Instance}}" Style="{StaticResource PhoneCommandButton}" Height="32" Margin="8,0,0,0" Click="Connect_Click"/>
                        </Grid>
                        <TextBlock x:Name="SavedDeviceSearchStatus" Style="{StaticResource PhoneHint}" Margin="0,6,0,0" Visibility="Collapsed"/>
                        <ItemsControl x:Name="RestoreUsbDevices" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Style="{StaticResource PhoneCommandButton}"
                                            MinHeight="32" Margin="0,8,0,0" Click="RestoreUsb_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
        <!-- 与自动化编辑页相同：选择应用时独占内容区，返回后恢复原滚动位置。 -->
        <Border x:Name="CatalogPanel" Style="{StaticResource PhoneCard}" Margin="2,0,4,10" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <Button x:Name="CloseCatalogButton" Content="{Binding [Phone.DoneButton], Source={x:Static local:L10n.Instance}}" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Height="32" MinWidth="64" Margin="10,0,0,0" Click="CloseCatalog_Click"/>
                    <TextBlock Text="{Binding [Phone.AppPickerTitle], Source={x:Static local:L10n.Instance}}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <TextBox x:Name="CatalogSearch" Grid.Row="1" Style="{StaticResource ModernTextBox}" local:InputAppearance.HasSearchIcon="True" Height="34" TextChanged="CatalogSearch_Changed" AutomationProperties.Name="{Binding [Phone.AppPickerSearchAutomation], Source={x:Static local:L10n.Instance}}"/>
                <TextBlock x:Name="CatalogStatus" Grid.Row="2" Style="{StaticResource PhoneHint}" Margin="0,8"/>
                <ListBox x:Name="CatalogApps" Grid.Row="3" Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                         ItemContainerStyle="{StaticResource RoundedListBoxItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch"
                         PreviewMouseRightButtonDown="CatalogApps_RightButtonDown" ContextMenuOpening="CatalogMenu_Opening">
                    <ListBox.ContextMenu>
                        <ContextMenu Style="{DynamicResource ConvenienceMenu}">
                            <MenuItem x:Name="AddSelectedAppsMenu" Header="{Binding [Phone.AddSelectedApps], Source={x:Static local:L10n.Instance}}" Style="{DynamicResource ConvenienceMenuItem}" Click="AddSelectedApps_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Image Source="{Binding Item.Icon}" Width="28" Height="28" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock Foreground="{DynamicResource Theme.TextPrimary}" Text="{Binding Item.Name}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Item.Package}" Style="{StaticResource PhoneHint}" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                            <Button Grid.Column="2" Tag="{Binding Item.App}" Style="{StaticResource PhonePinButton}" Click="RetainApp_Click" VerticalAlignment="Center"
                                    ToolTip="{Binding ActionText}" AutomationProperties.Name="{Binding ActionText}">
                                <Viewbox Style="{StaticResource PhonePinGraphic}"><Path Data="{x:Static local:AutomationIcons.Pin}" Fill="{DynamicResource Theme.Accent}"/></Viewbox>
                            </Button>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <TextBlock x:Name="OperationStatus" Grid.Row="1" Margin="4,0,4,8">
            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PhoneHint}">
                <Style.Triggers>
                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                    <DataTrigger Binding="{Binding IsVisible, ElementName=AirPlayCard}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style></TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
