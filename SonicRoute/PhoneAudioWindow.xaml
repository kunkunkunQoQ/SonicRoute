<Window x:Class="SonicRoute.PhoneAudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SonicRoute"
        Title="手机音频" Width="235" Height="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        AllowDrop="True" PreviewDragOver="PhoneApp_DragOver" PreviewDrop="PhoneApp_Drop" DragLeave="PhoneApp_DragLeave"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:PhoneDeviceNameConverter x:Key="PhoneDeviceName"/>
    </Window.Resources>
    <Border Background="{DynamicResource Theme.WindowBgAlpha}" BorderBrush="{DynamicResource Theme.Border}"
            BorderThickness="1" CornerRadius="12" Padding="8,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource Theme.SurfaceBgAlpha}" BorderBrush="{DynamicResource Theme.Border}"
                    BorderThickness="1" CornerRadius="10" Padding="6,5" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Grid.RowSpan="2" Width="56" Height="56" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border x:Name="MediaArtworkFrame" Background="{DynamicResource Theme.SurfaceBg}"
                                    BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <Grid.Clip>
                                        <RectangleGeometry Rect="0,0,56,56" RadiusX="8" RadiusY="8"/>
                                    </Grid.Clip>
                                    <TextBlock x:Name="MediaArtworkPlaceholder" Text="♫" FontSize="26"
                                               Foreground="{DynamicResource Theme.TextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="MediaArtwork" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <Border x:Name="MediaAppBadgeFrame" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Background="{DynamicResource Theme.SurfaceBg}" BorderBrush="{DynamicResource Theme.Border}"
                                    BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
                                <Image x:Name="MediaAppIcon" Stretch="UniformToFill"/>
                            </Border>
                        </Grid>
                        <Grid Grid.Column="1" Margin="6,0,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                <TextBlock x:Name="MediaTitle" Text="手机音乐" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource Theme.TextPrimary}" TextTrimming="CharacterEllipsis"
                                           MouseLeftButtonDown="Title_MouseLeftButtonDown"/>
                                <TextBlock x:Name="MediaSubtitle" Text="连接手机后显示播放状态" Margin="0,2,0,0" FontSize="10"
                                           Foreground="{DynamicResource Theme.TextSecondary}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel x:Name="MediaControlsHost" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button x:Name="MediaPreviousButton" Width="32" Height="28" Margin="2,0" Padding="0"
                                        Background="{DynamicResource Theme.SurfaceBg}" BorderBrush="Transparent" BorderThickness="0"
                                        Style="{StaticResource QuickPanelToolButton}" IsEnabled="False" Click="MediaPrevious_Click"
                                        AutomationProperties.Name="上一首">
                                    <Path Data="{x:Static local:AutomationIcons.PreviousTrack}" Width="15" Height="15"
                                          Fill="{DynamicResource Theme.TextPrimary}" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="MediaPlayPauseButton" Width="32" Height="28" Margin="2,0" Padding="0"
                                        Background="{DynamicResource Theme.SurfaceBg}" BorderBrush="Transparent" BorderThickness="0"
                                        Style="{StaticResource QuickPanelToolButton}" IsEnabled="False" Click="MediaPlayPause_Click"
                                        AutomationProperties.Name="播放或暂停">
                                    <Path x:Name="MediaPlayPausePath" Data="{x:Static local:AutomationIcons.Play}" Width="15" Height="15"
                                          Fill="{DynamicResource Theme.TextPrimary}" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="MediaNextButton" Width="32" Height="28" Margin="2,0" Padding="0"
                                        Background="{DynamicResource Theme.SurfaceBg}" BorderBrush="Transparent" BorderThickness="0"
                                        Style="{StaticResource QuickPanelToolButton}" IsEnabled="False" Click="MediaNext_Click"
                                        AutomationProperties.Name="下一首">
                                    <Path Data="{x:Static local:AutomationIcons.NextTrack}" Width="15" Height="15"
                                          Fill="{DynamicResource Theme.TextPrimary}" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="MediaPositionText" Text="00:00" FontSize="10" Foreground="{DynamicResource Theme.TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <Slider x:Name="MediaPositionSlider" Grid.Column="1" Height="20" Minimum="0" Maximum="1" IsEnabled="False" Focusable="True"
                                ValueChanged="MediaPosition_ValueChanged" PreviewMouseLeftButtonDown="MediaPosition_MouseDown"
                                PreviewMouseLeftButtonUp="MediaPosition_MouseUp" PreviewKeyDown="MediaPosition_KeyDown"
                                PreviewKeyUp="MediaPosition_KeyUp" LostMouseCapture="MediaPosition_LostCapture"/>
                        <TextBlock x:Name="MediaDurationText" Grid.Column="2" Text="--:--" FontSize="10"
                                   Foreground="{DynamicResource Theme.TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="0,0,0,6">
                <TextBox x:Name="SearchBox" Height="28" Style="{StaticResource ModernTextBox}"
                         local:InputAppearance.HasSearchIcon="True" VerticalContentAlignment="Center" Padding="8,0"
                         TextChanged="Search_Changed" AutomationProperties.Name="搜索应用名称或包名"/>
                <TextBlock x:Name="SearchHint" Text="搜索应用" Margin="36,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}" IsHitTestVisible="False"/>
            </Grid>
            <ListBox x:Name="PhoneApps" Grid.Row="2" Background="Transparent" BorderThickness="0"
                     VirtualizingPanel.IsVirtualizing="True"
                     Margin="0,0,-6,0" Padding="2,2,0,2" ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                     PreviewMouseLeftButtonDown="Apps_MouseDown" PreviewMouseMove="Apps_MouseMove"
                     PreviewKeyDown="Apps_KeyDown" QueryContinueDrag="Apps_QueryContinueDrag">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False"
                                          Style="{StaticResource PanelEdgeScrollViewer}" CanContentScroll="True"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemBorder" Background="{DynamicResource Theme.SurfaceBgAlpha}" BorderBrush="Transparent"
                                    BorderThickness="1" CornerRadius="10" Padding="6,3">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.Overlay}"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.Overlay}"/>
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Theme.Overlay}"/>
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></Setter.Value></Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate>
                    <DockPanel Height="42">
                        <Grid Width="28" Height="28" Margin="2,0,6,0">
                            <Border Background="{DynamicResource Theme.Accent}" CornerRadius="7"/>
                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding Icon}" Stretch="Uniform"/>
                        </Grid>
                        <Border DockPanel.Dock="Right" Background="{DynamicResource Theme.SurfaceBg}"
                                CornerRadius="6" Padding="5,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="播放中" FontSize="9" Foreground="{DynamicResource Theme.Accent}" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.TextPrimary}"/>
                            <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" FontSize="10"
                                       Foreground="{DynamicResource Theme.TextSecondary}"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="PhoneEmptyPanel" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="暂无显示的应用" Foreground="{DynamicResource Theme.TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <Button Content="管理手机应用" Style="{StaticResource QuickPanelToolButton}" Click="ManageApps_Click"/>
            </StackPanel>
            <Grid Grid.Row="3" Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                <Border x:Name="PhoneDeviceCard" Grid.Column="0" Height="36"
                        Background="{DynamicResource Theme.SurfaceBgAlpha}" BorderBrush="{DynamicResource Theme.Border}"
                        BorderThickness="1" CornerRadius="10" Padding="6,2,4,2">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                        <Path Data="M7,1 C5.9,1 5,1.9 5,3 L5,21 C5,22.1 5.9,23 7,23 L17,23 C18.1,23 19,22.1 19,21 L19,3 C19,1.9 18.1,1 17,1 Z M9,3 L15,3 M10,21 L14,21"
                              Width="14" Height="20" Stretch="Uniform" HorizontalAlignment="Left" Margin="1,0,0,0" VerticalAlignment="Center"
                              Stroke="{DynamicResource Theme.TextSecondary}" StrokeThickness="1.5"/>
                        <ComboBox x:Name="DeviceCombo" Grid.Column="1" Grid.ColumnSpan="3" Height="24" Background="Transparent" BorderThickness="0"
                                  Padding="0,0,64,0" FontSize="11" FontWeight="Bold" Style="{StaticResource RoundedComboBox}"
                                  SelectionChanged="Device_Changed" AutomationProperties.Name="已授权 Android 设备">
                            <ComboBox.Resources>
                                <!-- Reuse the shared arrow/template; reserve room for the status overlay. -->
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Padding" Value="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                </Style>
                            </ComboBox.Resources>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource PhoneDeviceName}">
                                                <Binding/>
                                                <Binding Path="Revision" Source="{StaticResource PhoneDeviceName}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Grid x:Name="ConnectionSignal" Grid.Column="2" Width="14" Height="12"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0"
                              ToolTip="正在测量连接延迟">
                            <Path x:Name="SignalOuter" Data="M0,3.3 Q7,-2.5 14,3.3 L12.4,4.9 Q7,0.4 1.6,4.9 Z"
                                  Fill="{DynamicResource Theme.Accent}" Opacity="0.2"/>
                            <Path x:Name="SignalNear" Data="M3.2,6.7 Q7,3.1 10.8,6.7 L9.2,8.3 Q7,6.1 4.8,8.3 Z"
                                  Fill="{DynamicResource Theme.Accent}" Opacity="0.2"/>
                            <Path x:Name="SignalDot" Data="M7,8.7 L8.5,10.2 L7,11.7 L5.5,10.2 Z"
                                  Fill="{DynamicResource Theme.Accent}" Opacity="0.2"/>
                        </Grid>
                        <Path x:Name="ConnectionUsbIcon" Grid.Column="2" Width="14" Height="14"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0"
                              Data="M7,1 L7,9 M7,5 L3,5 L3,8 M7,5 L11,5 L11,3 M7,9 L10,9 L10,12"
                              Stroke="{DynamicResource Theme.Accent}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                        <TextBlock x:Name="ConnectionText" Grid.Column="2" Margin="19,0,0,0" Width="37"
                                   Text="未连接" Foreground="{DynamicResource Theme.TextSecondary}"
                                   FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Button x:Name="RefreshButton" Grid.Column="2" Width="36" Height="36"
                        Style="{StaticResource QuickPanelToolButton}" Background="{DynamicResource Theme.SurfaceBg}"
                        Margin="0" Padding="0" Click="Refresh_Click" ToolTip="刷新" AutomationProperties.Name="刷新">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
