<UserControl x:Class="SonicRoute.WindowsLinkConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SonicRoute">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ToggleControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="LinkCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBgAlpha}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
            <Style x:Key="LinkActionButtonStyle" TargetType="Button" BasedOn="{StaticResource QuickPanelToolButton}">
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
                <Setter Property="Background" Value="{DynamicResource Theme.Overlay}"/>
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextAlignment="Center" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Tag" Value="Start">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Background" Value="{DynamicResource Theme.NavSelected}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel x:Name="RootStack">
        <Border x:Name="ReceiverHeader" Style="{StaticResource LinkCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Theme.Overlay}"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                    <Path x:Name="HeaderIconPath" Width="17" Height="17" Stretch="Uniform"
                          Stroke="{DynamicResource Theme.TextPrimary}" StrokeThickness="1.7"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Windows Link" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center"/>
                        <Border x:Name="ServiceStatusPill" Margin="8,0,0,0" Padding="7,2" CornerRadius="8"
                                Background="{DynamicResource Theme.Overlay}" VerticalAlignment="Center">
                            <TextBlock x:Name="ServiceStatusText" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.TextSecondary}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="HeaderSubtitleText"
                               Text="{Binding [Phone.WindowsLinkSteps], Source={x:Static local:L10n.Instance}}"
                               FontSize="11.5" Foreground="{DynamicResource Theme.TextSecondary}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <CheckBox x:Name="ServiceToggle" Grid.Column="2" Style="{StaticResource AutomationSwitch}"
                          Width="34" VerticalAlignment="Center" Click="ServiceToggle_Click"
                          AutomationProperties.Name="Windows Link"/>
            </Grid>
        </Border>

        <Button x:Name="ServiceToggleButton" Style="{StaticResource LinkActionButtonStyle}"
                Margin="0,0,0,6" Visibility="Collapsed" Click="ServiceToggleButton_Click"/>

        <Border x:Name="PairingCard" Style="{StaticResource LinkCard}"
                BorderBrush="{DynamicResource Theme.Accent}" BorderThickness="1.2" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="PairingPromptText" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Border CornerRadius="8" Background="{DynamicResource Theme.Overlay}"
                        Padding="10,8" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="PairingCodeText" FontSize="20" FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular" FontFamily="Consolas"
                               Foreground="{DynamicResource Theme.Accent}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AcceptPairingButton" Grid.Column="0" Style="{StaticResource LinkActionButtonStyle}"
                            Tag="Start" Height="Auto" MinHeight="30" Padding="6,4"
                            Content="{Binding [Phone.WindowsLinkPairAccept], Source={x:Static local:L10n.Instance}}"
                            Click="AcceptPairing_Click"/>
                    <Button x:Name="DeclinePairingButton" Grid.Column="2" Style="{StaticResource LinkActionButtonStyle}"
                            Height="Auto" MinHeight="30" Padding="6,4"
                            Content="{Binding [Phone.WindowsLinkPairDecline], Source={x:Static local:L10n.Instance}}"
                            Click="DeclinePairing_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border x:Name="DirectCard" Style="{StaticResource LinkCard}">
            <StackPanel>
                <TextBlock x:Name="DirectTitleText"
                           Text="{Binding [Phone.DirectConnectTitle], Source={x:Static local:L10n.Instance}}"
                           FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"
                           Margin="0,0,0,3"/>
                <TextBlock x:Name="DirectDescText"
                           Text="{Binding [Phone.WindowsLinkDirectDesc], Source={x:Static local:L10n.Instance}}"
                           FontSize="11.5" Foreground="{DynamicResource Theme.TextSecondary}"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                <Grid x:Name="DirectLayoutGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="DirectInputGrid" Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                        <ComboBox x:Name="SavedAddressCombo" Style="{StaticResource RoundedComboBox}"
                                  MinWidth="0" Height="30" Margin="0,0,0,6"
                                  Visibility="Collapsed" SelectionChanged="SavedAddressCombo_Changed"/>
                        <Grid>
                            <TextBox x:Name="AddressBox" Style="{StaticResource ModernTextBox}"
                                     MinWidth="0" Height="32" FontSize="12" VerticalContentAlignment="Center"
                                     Padding="8,0" TextChanged="AddressBox_TextChanged" KeyDown="AddressBox_KeyDown"/>
                            <TextBlock x:Name="AddressWatermark" Text="192.168.1.100:46916"
                                       FontSize="11.5" Foreground="{DynamicResource Theme.TextSecondary}" Opacity="0.65"
                                       VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </StackPanel>

                    <Grid x:Name="DirectButtonsGrid" Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SearchBtnCol" Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition x:Name="ConnectBtnCol" Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SearchButton" Grid.Column="0" Style="{StaticResource QuickPanelToolButton}"
                                Height="32" Padding="12,0"
                                Content="{Binding [Phone.SearchSavedDevices], Source={x:Static local:L10n.Instance}}"
                                Click="Search_Click"/>
                        <Button x:Name="ConnectButton" Grid.Column="2" Style="{StaticResource QuickPanelToolButton}"
                                Background="{DynamicResource Theme.NavSelected}" BorderBrush="{DynamicResource Theme.Accent}"
                                Height="32" Padding="14,0" FontWeight="SemiBold"
                                Content="{Binding [Phone.ConnectShort], Source={x:Static local:L10n.Instance}}"
                                Click="Connect_Click"/>
                    </Grid>
                </Grid>

                <Border x:Name="LocalAddressBadge" CornerRadius="7" Padding="7,3" Margin="0,8,0,0"
                        HorizontalAlignment="Left" Background="{DynamicResource Theme.Overlay}" Visibility="Collapsed"
                        Cursor="Hand" MouseLeftButtonUp="LocalAddressBadge_Click">
                    <TextBlock x:Name="LocalAddressText" FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}"
                               Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </Border>

                <TextBlock x:Name="SearchHintText"
                           Text="{Binding [Phone.WindowsLinkNoDevicesFound], Source={x:Static local:L10n.Instance}}"
                           FontSize="11.5" Foreground="{DynamicResource Theme.TextSecondary}"
                           TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Border x:Name="ErrorCard" Style="{StaticResource LinkCard}" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{DynamicResource Theme.Fail}" TextWrapping="Wrap"/>
        </Border>

        <ItemsControl x:Name="DiscoveredPeersList" Visibility="Collapsed">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource LinkCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Theme.Overlay}"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path Width="15" Height="15" Stretch="Uniform" Data="{x:Static local:AutomationIcons.Monitor}"
                                      Stroke="{DynamicResource Theme.TextPrimary}" StrokeThickness="1.7"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Theme.TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                           Foreground="{DynamicResource Theme.TextSecondary}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource QuickPanelToolButton}" Height="30" Padding="10,0" FontSize="11"
                                    Content="{Binding [Phone.ConnectShort], Source={x:Static local:L10n.Instance}}"
                                    Tag="{Binding}" Click="ConnectDiscovered_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
