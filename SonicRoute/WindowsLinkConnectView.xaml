<UserControl x:Class="SonicRoute.WindowsLinkConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SonicRoute">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ToggleControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="LinkCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBgAlpha}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
            <Style x:Key="LinkActionButtonStyle" TargetType="Button" BasedOn="{StaticResource QuickPanelToolButton}">
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
                <Setter Property="Background" Value="{DynamicResource Theme.Overlay}"/>
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextAlignment="Center" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Tag" Value="Start">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Background" Value="{DynamicResource Theme.NavSelected}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel x:Name="RootStack">
        <Border x:Name="ReceiverHeader" Style="{StaticResource LinkCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource Theme.NavSelected}"
                        VerticalAlignment="Center" Margin="0,0,9,0">
                    <Path Width="17" Height="17" Stretch="Uniform" Data="{x:Static local:AutomationIcons.Monitor}"
                          Stroke="{DynamicResource Theme.TextPrimary}" StrokeThickness="1.7"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="Windows Link" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.TextPrimary}"/>
                    <StackPanel x:Name="HeaderStatus" Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse x:Name="ServiceStatusDot" Width="5" Height="5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ServiceStatusText" FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <TextBlock x:Name="HeaderSubtitleText" Text="{Binding [Phone.WindowsLinkSteps], Source={x:Static local:L10n.Instance}}"
                               Foreground="{DynamicResource Theme.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <CheckBox x:Name="ServiceToggle" Grid.Column="2" Style="{StaticResource AutomationSwitch}"
                          Width="36" Height="32" VerticalAlignment="Center" Checked="ServiceToggle_Changed" Unchecked="ServiceToggle_Changed"
                          AutomationProperties.ItemStatus="{Binding Text, ElementName=ServiceStatusText}"/>
            </Grid>
        </Border>

        <Border x:Name="PairingCard" Style="{StaticResource LinkCard}"
                BorderBrush="{DynamicResource Theme.Accent}" BorderThickness="1.2" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="PairingPromptText" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Border CornerRadius="8" Background="{DynamicResource Theme.Overlay}"
                        Padding="10,8" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="PairingCodeText" FontSize="20" FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular" FontFamily="Consolas"
                               Foreground="{DynamicResource Theme.Accent}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AcceptPairingButton" Grid.Column="0" Style="{StaticResource LinkActionButtonStyle}"
                            Tag="Start" Height="Auto" MinHeight="30" Padding="6,4"
                            Content="{Binding [Phone.WindowsLinkPairAccept], Source={x:Static local:L10n.Instance}}"
                            Click="AcceptPairing_Click"/>
                    <Button x:Name="DeclinePairingButton" Grid.Column="2" Style="{StaticResource LinkActionButtonStyle}"
                            Height="Auto" MinHeight="30" Padding="6,4"
                            Content="{Binding [Phone.WindowsLinkPairDecline], Source={x:Static local:L10n.Instance}}"
                            Click="DeclinePairing_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border x:Name="DevicesCard" Style="{StaticResource LinkCard}">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <Button x:Name="SearchButton" DockPanel.Dock="Right" Style="{StaticResource QuickPanelToolButton}"
                            Height="30" MinWidth="44" Padding="8,0" Margin="6,0,0,0"
                            AutomationProperties.Name="{Binding [Phone.SearchSavedDevices], Source={x:Static local:L10n.Instance}}"
                            Content="{Binding [Phone.SearchSavedDevices], Source={x:Static local:L10n.Instance}}"
                            Click="Search_Click"/>
                    <TextBlock Text="{Binding [Phone.WindowsLinkDevices], Source={x:Static local:L10n.Instance}}"
                               FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <TextBlock x:Name="SearchHintText"
                           Text="{Binding [Phone.WindowsLinkNoDevicesFound], Source={x:Static local:L10n.Instance}}"
                           FontSize="11.5" Foreground="{DynamicResource Theme.TextSecondary}"
                           TextWrapping="Wrap" Margin="0,2,0,4" Visibility="Collapsed"/>

                <ItemsControl x:Name="DiscoveredPeersList" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.RowSpan="2" Width="27" Height="27" CornerRadius="7" Background="{DynamicResource Theme.DeviceIconBackground}"
                                        Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Path Width="14" Height="14" Stretch="Uniform" Data="{x:Static local:AutomationIcons.Monitor}"
                                          Stroke="{DynamicResource Theme.DeviceIconForeground}" StrokeThickness="1.6"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Margin="0,0,5,0"
                                           ToolTip="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Theme.TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status}" FontSize="11" Margin="0,1,5,0"
                                           ToolTip="{Binding Subtitle}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Theme.TextSecondary}"/>
                                <Button Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource QuickPanelToolButton}"
                                        Height="30" MinWidth="44" Padding="7,0" Margin="0" FontSize="11" VerticalAlignment="Center"
                                        Content="{Binding [Phone.ConnectShort], Source={x:Static local:L10n.Instance}}"
                                        IsEnabled="{Binding CanConnect}" Visibility="{Binding ConnectVisibility}"
                                        Tag="{Binding}" Click="ConnectPeer_Click"/>
                                <Button x:Name="OpenPeerButton" Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource QuickPanelToolButton}"
                                        Height="30" MinWidth="44" Padding="7,0" Margin="0" FontSize="11" VerticalAlignment="Center"
                                        Content="{Binding [Phone.LinkOpenPeer], Source={x:Static local:L10n.Instance}}"
                                        Visibility="{Binding OpenVisibility}" Tag="{Binding}" Click="OpenPeer_Click"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Address}" ToolTip="{Binding Address}"
                                           FontSize="10.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Theme.TextSecondary}" Typography.NumeralAlignment="Tabular">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers><DataTrigger Binding="{Binding Address}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding Failure}" Visibility="{Binding FailureVisibility}"
                                           Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Fail}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border x:Name="ErrorCard" Style="{StaticResource LinkCard}" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{DynamicResource Theme.Fail}" TextWrapping="Wrap"/>
        </Border>

        <Border x:Name="DirectCard" Style="{StaticResource LinkCard}">
            <StackPanel>
                <TextBlock Text="{Binding [Phone.DirectConnectTitle], Source={x:Static local:L10n.Instance}}"
                           FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Grid x:Name="DirectForm" SizeChanged="DirectForm_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="DirectInputGrid" Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                        <TextBox x:Name="AddressBox" Style="{StaticResource ModernTextBox}"
                                 MinWidth="0" Height="32" FontSize="12" VerticalContentAlignment="Center"
                                 Padding="8,0" TextChanged="AddressBox_TextChanged" KeyDown="AddressBox_KeyDown"
                                 ToolTip="{Binding [Phone.WindowsLinkDirectDesc], Source={x:Static local:L10n.Instance}}"
                                 AutomationProperties.Name="{Binding [Phone.WindowsLinkDirectDesc], Source={x:Static local:L10n.Instance}}"/>
                        <TextBlock x:Name="AddressWatermark" Text="{Binding [Phone.WindowsLinkAddressHint], Source={x:Static local:L10n.Instance}}"
                                   FontSize="11.5" Foreground="{DynamicResource Theme.TextSecondary}" Opacity="0.65"
                                   VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <Grid x:Name="DirectButtonsGrid" Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <Button x:Name="ConnectButton" Style="{StaticResource QuickPanelToolButton}"
                                Background="{DynamicResource Theme.NavSelected}" BorderBrush="{DynamicResource Theme.Accent}"
                                Height="32" MinWidth="46" Padding="8,0" Margin="0" FontWeight="SemiBold" IsEnabled="False" SizeChanged="DirectForm_SizeChanged"
                                Content="{Binding [Phone.ConnectShort], Source={x:Static local:L10n.Instance}}"
                                Click="Connect_Click"/>
                    </Grid>
                </Grid>

                <TextBlock x:Name="DirectNoticeText" AutomationProperties.LiveSetting="Polite" FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}"
                           Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                <Button x:Name="LocalAddressBadge" Style="{StaticResource QuickPanelToolButton}"
                        HorizontalAlignment="Left" Margin="0,6,0,0" Padding="3,3" MinHeight="26"
                        Background="Transparent" BorderBrush="Transparent" Visibility="Collapsed"
                        Cursor="Hand" Click="LocalAddressBadge_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LocalAddressText" FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}"
                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis"/>
                        <Viewbox Grid.Column="1" Margin="5,0,0,0" Width="12" Height="12" IsHitTestVisible="False">
                            <Path Width="24" Height="24" Data="{x:Static local:AutomationIcons.Copy}" Stroke="{DynamicResource Theme.TextSecondary}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round"/>
                        </Viewbox>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
