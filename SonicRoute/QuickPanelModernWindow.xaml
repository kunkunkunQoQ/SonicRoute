<Window x:Class="SonicRoute.QuickPanelModernWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SonicRoute"
        Title="SonicRoute"
        Width="372"
        Height="450"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei">
    <Window.Resources>
        <!-- Factory only: additional controls are instantiated on expansion and released on collapse. -->
        <DataTemplate x:Key="OutputVolumePopupTemplate">
            <Border x:Name="OutputPopupSurface" Width="366" Padding="14,12" ClipToBounds="True"
                    Background="{DynamicResource Theme.WindowBgAlpha}" BorderBrush="{DynamicResource Theme.Border}"
                    BorderThickness="1" CornerRadius="12" PreviewKeyDown="OutputPopup_PreviewKeyDown">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Height="24" Margin="0,0,0,8">
                        <TextBlock Text="{Binding [Qp.Output], Source={x:Static local:L10n.Instance}}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="OutputVolumeRowsPanel"/>
                        </ScrollViewer>
                        <TextBlock x:Name="OutputVolumeEmptyText" Text="{Binding [Ov.NoDevice], Source={x:Static local:L10n.Instance}}"
                                   Foreground="{DynamicResource Theme.TextSecondary}" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- 设备快速切换按钮 -->
        <Style x:Key="DevButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 已选中（当前）设备按钮：高亮 -->
        <Style x:Key="DevButtonActive" TargetType="Button" BasedOn="{StaticResource DevButton}">
            <Setter Property="Background" Value="{DynamicResource Theme.Overlay}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 应用行展开按钮（▾/▴） -->
        <Style x:Key="RowExpandButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.NavHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

<!-- 应用行音量条：简化模板（进度/圆点用 Foreground 着色，静音时反色） -->
        <Style x:Key="RowSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="32"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <Border x:Name="PART_TrackBg" Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Margin="14,0" IsHitTestVisible="False" Background="{DynamicResource Theme.Border}"/>
                            <Border x:Name="PART_TrackFill" Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Margin="14,0" IsHitTestVisible="False" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" Width="0"/>
                            <Border x:Name="PART_PeakVisual" Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Margin="14,0" Background="{DynamicResource Theme.AccentPeak}"
                                    RenderTransformOrigin="0,0.5" IsHitTestVisible="False" Visibility="Hidden"/>
                            </Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                </RepeatButton></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                </RepeatButton></Track.IncreaseRepeatButton>
                                <Track.Thumb>
                            <Thumb x:Name="PART_Thumb" Width="28"
                                   Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Background="Transparent">
                                            <Grid Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=Slider}}">
                                                <Border x:Name="ThumbBg" Width="14" Height="14" CornerRadius="7" Background="{TemplateBinding Background}"/>
                                            </Grid>
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行图标按钮（点击静音/取消静音该应用） -->
        <Style x:Key="RowIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.NavHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="PanelSurface" Margin="0,0,6,0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PanelSlide"/>
        </Grid.RenderTransform>
        <!-- 主面板背景。 -->
        <Border Background="{DynamicResource Theme.WindowBgAlpha}"
                BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="12"
                IsHitTestVisible="False">
        </Border>
    <Border x:Name="RootBorder" BorderThickness="1" CornerRadius="12">

        <!-- 固定高度 Grid 布局：窗口高度恒定（由 ApplyFixedPanelHeight 计算），
             底部操作栏为独立固定行永远贴底，应用区域为唯一可伸缩/滚动区域，
             展开/收起只在应用区域内变化，不改变窗口尺寸 -->
        <Grid Margin="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 顶部标题 -->
                <RowDefinition Height="Auto"/> <!-- 输出设备选择 -->
                <RowDefinition Height="Auto"/> <!-- 主音量 -->
                <RowDefinition Height="Auto"/> <!-- 分隔 + 应用音量标题 -->
                <RowDefinition Height="*"/>    <!-- 应用区域：唯一可伸缩/滚动 -->
                <RowDefinition Height="Auto"/> <!-- 分隔 -->
                <RowDefinition Height="Auto"/> <!-- 底部操作栏：永远固定在面板最底部 -->
            </Grid.RowDefinitions>

            <!-- 标题行 -->
            <DockPanel Grid.Row="0">
                <TextBlock Text="SonicRoute"
                           FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                <TextBlock x:Name="VersionText" FontSize="10" Foreground="{DynamicResource Theme.TextSecondary}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>

            <!-- 输出设备选择 -->
            <DockPanel Grid.Row="1" Margin="0,10,0,0">
                <ToggleButton x:Name="OutputVolumesToggle" Style="{StaticResource RowExpandButton}"
                              Background="{DynamicResource Theme.SurfaceBg}"
                              DockPanel.Dock="Right" Width="30" Height="32" Margin="6,0,0,0"
                              Content="▴" Click="OutputVolumesToggle_Click"/>
                <ComboBox x:Name="SystemDevCombo" Style="{StaticResource RoundedComboBox}" Height="32"
                          SelectionChanged="SystemDevCombo_SelectionChanged"/>
            </DockPanel>

            <!-- 主音量：大滑块 + 静音 + 百分比（滚轮可调） -->
            <DockPanel Grid.Row="2" Margin="0,10,0,0" MouseWheel="Volume_MouseWheel">
                <Button x:Name="MuteButton"
                        Content="{Binding [Qp.Mute], Source={x:Static local:L10n.Instance}}"
                        Style="{StaticResource QuickPanelToolButton}" DockPanel.Dock="Left" MinWidth="54" Height="28"
                        Margin="0,0,10,0" Click="MuteButton_Click"/>
                <TextBlock x:Name="VolumePercentText" Text="0%" DockPanel.Dock="Right"
                           FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"
                           VerticalAlignment="Center" Margin="10,0,0,0" Width="42" TextAlignment="Right"/>
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100"
                        VerticalAlignment="Center" IsMoveToPointEnabled="True" Height="32"
                        ValueChanged="VolumeSlider_ValueChanged"/>
            </DockPanel>

            <!-- 分隔 + 应用音量标题 -->
            <StackPanel Grid.Row="3">
                <Border Height="1" Background="{DynamicResource Theme.Border}" Margin="0,10,0,8"/>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="{Binding [Qp.AppVolumes], Source={x:Static local:L10n.Instance}}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.TextSecondary}"/>
                </DockPanel>
            </StackPanel>

            <!-- 应用列表：全部有音频的应用，每行独立音量，行右侧展开设置输出/输入设备（区域内滚动） -->
            <ScrollViewer x:Name="AppListScroll" Grid.Row="4" MinHeight="36" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,0,-14,0">
                <!-- Keep the application viewport fixed; the shared 14-DIP scrollbar uses the right margin. -->
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Padding" Value="0,0,14,0"/>
                        <Style.Triggers>
                            <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Visible">
                                <Setter Property="Padding" Value="0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl x:Name="AppListPanel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="5" Height="1" Background="{DynamicResource Theme.Border}" Margin="0,8,0,10"/>

            <!-- 底部操作栏：三按钮一行，永远固定在面板最底部（应用展开/收起不影响） -->
            <DockPanel Grid.Row="6">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button x:Name="GlobalMuteButton"
                            Content="{Binding [Qp.GlobalMute], Source={x:Static local:L10n.Instance}}"
                            Style="{StaticResource QuickPanelToolButton}" MinWidth="112" Height="28"
                            Click="GlobalMuteButton_Click"/>
                    <Button x:Name="MicMuteButton"
                            Content="{Binding [Qp.MicMute], Source={x:Static local:L10n.Instance}}"
                            Style="{StaticResource QuickPanelToolButton}" MinWidth="120" Height="28"
                            Click="MicMuteButton_Click"/>
                    <Button x:Name="FullUiButton"
                            Content="{Binding [Qp.FullUi], Source={x:Static local:L10n.Instance}}"
                            Style="{StaticResource QuickPanelToolButton}" MinWidth="76" Height="28"
                            Click="SettingsButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
        <!-- Additional output controls have their own HWND and never resize/reposition the main panel. -->
        <Popup x:Name="OutputVolumesPopup" Placement="Custom"
               AllowsTransparency="True" StaysOpen="True" PopupAnimation="None"/>
    </Grid>
</Window>
