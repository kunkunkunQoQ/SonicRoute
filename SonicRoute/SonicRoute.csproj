<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../build/Version.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>SonicRoute.Program</StartupObject>
    <TargetFrameworks Condition="'$(TargetFramework)' == ''">net10.0-windows</TargetFrameworks>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SonicRoute</RootNamespace>
    <AssemblyName>SonicRoute</AssemblyName>
    <!-- 原生双架构：无 RID 的普通构建保持 x64（现有行为不变）；
         带 RID 发布（-r win-x64 / -r win-arm64）时不预设，由 SDK 依据 RID 自动推导 PlatformTarget（x64 / arm64） -->
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == ''">x64</PlatformTarget>
    <!-- 官方 portable RID（不使用 win10-x64 / win10-arm64） -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AssemblyTitle>SonicRoute</AssemblyTitle>
    <AssemblyTitle Condition="'$(SonicRouteEdition)' == 'Lite'">SonicRoute Lite</AssemblyTitle>
    <Product>音跃 SonicRoute</Product>
    <Product Condition="'$(SonicRouteEdition)' == 'Lite'">音跃 SonicRoute Lite</Product>
    <Authors>困困困</Authors>
    <Company>困困困</Company>
    <Description>音跃 SonicRoute — 按应用切换 Windows 音频播放/录音设备，快速面板 + 完整管理界面</Description>
    <ApplicationIcon>SonicRoute.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="QRCoder" Version="1.7.0" Condition="'$(SonicRouteEdition)' == 'Full'" />
    <ProjectReference Include="..\SonicRoute.Core\SonicRoute.Core.csproj" /><ProjectReference Include="..\StoreInterop\StoreInterop.csproj" />
    <ProjectReference Include="..\SonicRoute.AndroidAudio\SonicRoute.AndroidAudio.csproj" Condition="'$(SonicRouteEdition)' == 'Full'" />
    <Resource Include="SonicRoute.png" />
    <Resource Include="SonicRoute.ico" />
    <EmbeddedResource Include="Resources\Lang\*.json" />
    <EmbeddedResource Include="Resources\RuleCommand.ps1" LogicalName="SonicRoute.Resources.RuleCommand.ps1" />
  </ItemGroup>

  <ItemGroup Condition="'$(SonicRouteEdition)' == 'Lite'">
    <Compile Remove="AndroidAudioHost.cs;AndroidAppDragController.cs;PhoneAudioWindow.xaml.cs;PhoneDevicePage.xaml.cs" />
    <Page Remove="PhoneAudioWindow.xaml;PhoneDevicePage.xaml" />
  </ItemGroup>
  <ItemGroup Condition="'$(SonicRouteEdition)' == 'Full'">
    <EmbeddedResource Include="..\build\FullRelease.files.json" LogicalName="SonicRoute.FullRelease.files.json" />
  </ItemGroup>

  <!--
    发布命令（RID 必须走命令行，不能用 pubxml 里的 RuntimeIdentifier）：
      x64   ：dotnet publish SonicRoute/SonicRoute.csproj -c Release -r win-x64   -p:PublishProfile=win-x64
      ARM64 ：dotnet publish SonicRoute/SonicRoute.csproj -c Release -r win-arm64 -p:PublishProfile=win-arm64
    原因：命令行 -r 是全局属性，会流向 ProjectReference，使 SonicRoute.Core 与主程序同架构；
          写在 pubxml 里的 RuntimeIdentifier 是普通属性、不会流向 Core，会把 Core 编成 x64，
          产生混合架构产物并触发 CS8012「引用程序集面向的是另一个处理器」。
  -->

</Project>
