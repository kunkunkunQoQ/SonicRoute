<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SonicRoute">
    <!-- 主题模式共用同一模板，保留 RadioButton 原有分组及键盘行为。 -->
    <Style x:Key="ThemeChoice" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
        <Setter Property="FontSize" Value="12.5"/><Setter Property="MinWidth" Value="68"/>
        <Setter Property="Height" Value="46"/><Setter Property="Margin" Value="0,0,6,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Surface" Background="{DynamicResource Theme.SurfaceBg}" BorderBrush="{DynamicResource Theme.Border}"
                            BorderThickness="1" CornerRadius="9" Padding="9,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Viewbox x:Name="GlyphBox" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path x:Name="Glyph" Width="24" Height="24" Data="{x:Static local:AutomationIcons.Theme}" Stroke="{DynamicResource Theme.TextSecondary}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Viewbox>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            <Border x:Name="Selected" Grid.ColumnSpan="2" Width="13" Height="13" CornerRadius="7" Background="{DynamicResource Theme.Accent}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-6,0" Visibility="Collapsed">
                                <Path Data="M3,6 L5,8 L10,3" Stroke="{DynamicResource Theme.OnAccent}" StrokeThickness="1.4"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="system"><Setter TargetName="Glyph" Property="Data" Value="{x:Static local:AutomationIcons.Monitor}"/></Trigger>
                        <Trigger Property="Tag" Value="light"><Setter TargetName="Glyph" Property="Data" Value="{x:Static local:AutomationIcons.Sun}"/></Trigger>
                        <Trigger Property="Tag" Value="dark"><Setter TargetName="Glyph" Property="Data" Value="{x:Static local:AutomationIcons.Moon}"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.NavHover}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.NavSelected}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                            <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Theme.Accent}"/>
                            <Setter TargetName="Selected" Property="Visibility" Value="Visible"/><Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ThemeSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14.5"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
    </Style>
    <Style x:Key="ThemeHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/><Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>
    <Style x:Key="ThemeCardHeader" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ContentControl">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="14" Background="{DynamicResource Theme.NavSelected}" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Viewbox Width="21" Height="21">
                            <Path Data="{TemplateBinding Tag}" Width="24" Height="24" Stroke="{DynamicResource Theme.Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Viewbox>
                    </Border>
                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="ThemeSliderLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="ThemeSliderValue" TargetType="TextBlock" BasedOn="{StaticResource ThemeSliderLabel}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/><Setter Property="TextAlignment" Value="Right"/>
    </Style>
    <!-- 静态矢量示意，直接引用主题画刷；不复制真实窗口，不启动计时器或动画。 -->
    <DataTemplate x:Key="ThemePreview">
        <Border Background="{DynamicResource Theme.SurfaceAlt}" CornerRadius="11" Padding="10" IsHitTestVisible="False">
            <StackPanel>
                <DockPanel Margin="0,0,0,7">
                    <TextBlock Text="{Binding [Th.Preview], Source={x:Static local:L10n.Instance}}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Fill="{DynamicResource Theme.Border}" Width="6" Height="6" Margin="3,0"/>
                        <Ellipse Fill="{DynamicResource Theme.Border}" Width="6" Height="6" Margin="3,0"/>
                        <Ellipse Fill="{DynamicResource Theme.Border}" Width="6" Height="6" Margin="3,0"/>
                    </StackPanel>
                </DockPanel>
                <Border Background="{DynamicResource Theme.SurfaceBg}" CornerRadius="6" Padding="7">
                    <Grid Height="68">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <Border Background="{DynamicResource Theme.SliderBg}" Height="5" CornerRadius="3" Margin="4,6,12,7"/>
                            <Border Background="{DynamicResource Theme.NavSelected}" Height="16" CornerRadius="4" Padding="5">
                                <Border Background="{DynamicResource Theme.Accent}" Height="5" CornerRadius="3"/>
                            </Border>
                            <Border Background="{DynamicResource Theme.SliderBg}" Height="5" CornerRadius="3" Margin="4,9,17,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <DockPanel Margin="2,3,0,9">
                                <Ellipse Fill="{DynamicResource Theme.Accent}" Width="11" Height="11" DockPanel.Dock="Right"/>
                                <Border Background="{DynamicResource Theme.SliderBg}" Width="55" Height="5" CornerRadius="3" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <Border BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="5" Padding="6">
                                <DockPanel>
                                    <Border Background="{DynamicResource Theme.NavSelected}" Width="22" Height="22" CornerRadius="4" Margin="0,0,7,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <Border Background="{DynamicResource Theme.SliderBg}" Height="5" CornerRadius="3" Margin="0,0,0,5"/>
                                        <Border Background="{DynamicResource Theme.Border}" Height="4" Width="35" CornerRadius="2" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
