<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SonicRoute">
    <Style x:Key="MoreOptionsToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
        <Setter Property="FontSize" Value="11.5"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Padding" Value="0"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Surface" Background="Transparent" Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter VerticalAlignment="Center"/>
                        <Viewbox Width="9" Height="9" Margin="6,0,0,0" VerticalAlignment="Center">
                            <Path x:Name="Arrow" Data="{x:Static local:AutomationIcons.ChevronDown}" Width="24" Height="24" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="2" RenderTransformOrigin="0.5,0.5"/>
                        </Viewbox>
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsSectionHeader" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
        <Setter Property="FontSize" Value="14.5"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ContentControl">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Viewbox Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Path Data="{TemplateBinding Tag}" Width="24" Height="24" Stroke="{DynamicResource Theme.Accent}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Viewbox>
                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <!-- 整行可点击；右侧沿用自动化与主题页的同一开关模板。 -->
    <Style x:Key="SettingsSwitchRow" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
        <Setter Property="FontSize" Value="12.5"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="CheckBox">
                <Border Background="Transparent" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1" Padding="2,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                        <Viewbox Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Path Data="{TemplateBinding Tag}" Width="24" Height="24" Stroke="{DynamicResource Theme.TextSecondary}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Viewbox>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <CheckBox Grid.Column="2" Style="{DynamicResource AutomationSwitch}" IsChecked="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                  IsEnabled="{TemplateBinding IsEnabled}" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsDeviceCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
        <Setter Property="Width" Value="184"/><Setter Property="MinHeight" Value="46"/>
        <Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="CheckBox">
                <Border x:Name="Surface" Background="{DynamicResource Theme.SurfaceBg}" BorderBrush="{DynamicResource Theme.Border}"
                        BorderThickness="1" CornerRadius="8" Padding="9,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="14" Height="14" CornerRadius="3" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M2,6 L5,9 L11,3" Stroke="{DynamicResource Theme.OnAccent}" StrokeThickness="1.5" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Theme.Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsAppChoice" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
        <Setter Property="FontSize" Value="12.5"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="RadioButton">
                <Border x:Name="Surface" Background="{DynamicResource Theme.SurfaceBg}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="8" Padding="10,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="Ring" Width="13" Height="13" CornerRadius="7" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource Theme.Accent}" Visibility="Collapsed"/>
                        </Border>
                        <Viewbox Grid.Column="1" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Path x:Name="Glyph" Data="{x:Static local:AutomationIcons.Clock}" Width="24" Height="24" Stroke="{DynamicResource Theme.TextSecondary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Viewbox>
                        <ContentPresenter Grid.Column="2" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="Tag" Value="last"><Setter TargetName="Glyph" Property="Data" Value="{x:Static local:AutomationIcons.History}"/></Trigger>
                    <Trigger Property="Tag" Value="fixed"><Setter TargetName="Glyph" Property="Data" Value="{x:Static local:AutomationIcons.Apps}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.NavSelected}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/><Setter TargetName="Dot" Property="Visibility" Value="Visible"/><Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Theme.Accent}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
</ResourceDictionary>
