                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding [Exp.ConfigBackup], Source={x:Static local:L10n.Instance}}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding [Exp.ConfigTransferHint], Source={x:Static local:L10n.Instance}}"
                                           FontSize="11.5" Foreground="{DynamicResource Theme.TextSecondary}"
                                           Margin="0,-4,0,10" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ExpExportConfigButton" Content="{Binding [Exp.ExportConfig], Source={x:Static local:L10n.Instance}}"
                                            Style="{StaticResource GhostButton}" Height="34" Padding="16,0"
                                            Margin="0,0,10,0" HorizontalAlignment="Left" Click="ExpExportConfig_Click"/>
                                    <Button x:Name="ExpImportConfigButton" Content="{Binding [Exp.ImportConfig], Source={x:Static local:L10n.Instance}}"
                                            Style="{StaticResource GhostButton}" Height="34" Padding="16,0"
                                            HorizontalAlignment="Left" Click="ExpImportConfig_Click"
                                            AllowDrop="True" DragOver="ExpImportConfigButton_DragOver" Drop="ExpImportConfigButton_Drop"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <!-- 自动化（极简规则） -->
            <Grid x:Name="AutomationPage" Visibility="Collapsed">
                <ScrollViewer x:Name="AutomationScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel x:Name="AutoListPanel">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding [Nav.Automation], Source={x:Static local:L10n.Instance}}"
                                           FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                                <TextBlock Text="{Binding [Auto.Hint], Source={x:Static local:L10n.Instance}}"
                                           FontSize="12" Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="AutoNewButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                    MinWidth="136" Height="40" VerticalAlignment="Center" Click="AutoNew_Click">
                                <StackPanel Orientation="Horizontal" Margin="12,0">
                                    <TextBlock Text="{Binding [Auto.New], Source={x:Static local:L10n.Instance}}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,0,10">
