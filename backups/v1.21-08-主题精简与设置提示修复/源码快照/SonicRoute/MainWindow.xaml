                                        <TextBlock x:Name="AutoEditTitle" Text="{Binding [Auto.EditorNew], Source={x:Static local:L10n.Instance}}"
                                                   FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                                        <TextBlock Text="{Binding [Auto.EditorHint], Source={x:Static local:L10n.Instance}}" FontSize="11.5"
                                                   Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Height="1" Background="{DynamicResource Theme.Border}" Margin="0,14,0,12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <ContentControl Style="{StaticResource AutomationSectionIcon}" Content="{x:Static local:AutomationIcons.Info}" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding [Auto.BasicInfo], Source={x:Static local:L10n.Instance}}" FontSize="14.5"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [Auto.Name], Source={x:Static local:L10n.Instance}}" Style="{StaticResource AutomationFormLabel}"/>
                                    <TextBox x:Name="AutoNameBox" Grid.Column="1" FontSize="12.5" Height="34" Padding="9,4"
                                             AutomationProperties.Name="{Binding [Auto.Name], Source={x:Static local:L10n.Instance}}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [Auto.Trigger], Source={x:Static local:L10n.Instance}}" Style="{StaticResource AutomationFormLabel}"/>
                                    <ComboBox x:Name="AutoTriggerCombo" Grid.Column="1" Style="{StaticResource SelCombo}"
                                              AutomationProperties.Name="{Binding [Auto.Trigger], Source={x:Static local:L10n.Instance}}"
                                              SelectionChanged="AutoTriggerCombo_SelectionChanged"/>
                                </Grid>
                                <Grid x:Name="AutoHotkeyPanel" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [Auto.Hotkey], Source={x:Static local:L10n.Instance}}" Style="{StaticResource AutomationFormLabel}" VerticalAlignment="Top" Margin="0,9,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <Button x:Name="AutoHotkeyCapture" Style="{StaticResource GhostButton}" Height="34"
                                                Foreground="{DynamicResource Theme.OsdTitleText}" FontWeight="SemiBold" Click="AutoHotkeyCapture_Click"/>
                                        <TextBlock x:Name="AutoHotkeyHintText" Text="{Binding [Auto.HotkeyHint], Source={x:Static local:L10n.Instance}}"
                                                   FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="AutoTriggerAppPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [Auto.TriggerApp], Source={x:Static local:L10n.Instance}}" Style="{StaticResource AutomationFormLabel}"/>
                                    <ComboBox x:Name="AutoTriggerAppCombo" Grid.Column="1" Style="{StaticResource SelCombo}"
                                              ItemTemplate="{StaticResource AutoAppItemTemplate}"/>
                                </Grid>
                                <!-- 定时区（触发 = 定时：仅一次 / 每天 / 每周） -->
                                <StackPanel x:Name="AutoSchedulePanel" Margin="84,10,0,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [Auto.ScheduleMode], Source={x:Static local:L10n.Instance}}"
                                                       FontSize="12.5" Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="AutoScheduleModeCombo" Style="{StaticResource SelCombo}" Width="140"
                                                      HorizontalAlignment="Left" SelectionChanged="AutoScheduleModeCombo_SelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel Margin="14,0,0,0">
                                            <TextBlock Text="{Binding [Auto.ScheduleTime], Source={x:Static local:L10n.Instance}}"
                                                       FontSize="12.5" Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <ComboBox x:Name="AutoScheduleHourCombo" Style="{StaticResource SelCombo}" Width="62"
                                                          HorizontalAlignment="Left"/>
                                                <TextBlock Text=":" FontSize="12.5" VerticalAlignment="Center" Margin="4,0"/>
                                                <ComboBox x:Name="AutoScheduleMinuteCombo" Style="{StaticResource SelCombo}" Width="62"
                                                          HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel x:Name="AutoScheduleWeekdayPanel" Margin="0,0,0,0">
                                        <TextBlock Text="{Binding [Auto.ScheduleWeekday], Source={x:Static local:L10n.Instance}}"
                                                   FontSize="12.5" Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,0,0,4"/>
                                        <WrapPanel x:Name="AutoWeekdayPanel"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource Theme.Border}" Margin="0,16,0,12"/>
                                <DockPanel Margin="0,0,0,10">
                                    <ContentControl Style="{StaticResource AutomationSectionIcon}" Content="{x:Static local:AutomationIcons.Play}" Margin="0,0,12,0" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding [Auto.Action], Source={x:Static local:L10n.Instance}}" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,0" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding [Auto.ActionsHint], Source={x:Static local:L10n.Instance}}" FontSize="11.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl x:Name="AutoStepsHost">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Button x:Name="AutoAddStepBtn" Click="AutoAddStep_Click" Content="{Binding [Auto.AddAction], Source={x:Static local:L10n.Instance}}"
                                        Style="{StaticResource GhostButton}" MinWidth="160" Height="34" HorizontalAlignment="Left"/>
                                <Border Height="1" Background="{DynamicResource Theme.Border}" Margin="0,16,0,14"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="AutoCancelButton" Content="{Binding [Auto.Cancel], Source={x:Static local:L10n.Instance}}"
                                            Style="{StaticResource GhostButton}" MinWidth="90" Margin="0,0,10,0" Click="AutoCancel_Click"/>
                                    <Button x:Name="AutoSaveButton" Content="{Binding [Auto.Save], Source={x:Static local:L10n.Instance}}"
                                            Style="{StaticResource PrimaryButton}" MinWidth="110" Click="AutoSave_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            </Grid>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>
