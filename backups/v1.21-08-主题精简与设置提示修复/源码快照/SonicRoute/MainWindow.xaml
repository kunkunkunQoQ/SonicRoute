<Window x:Class="SonicRoute.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SonicRoute"
        Title="音跃 SonicRoute"
        Icon="SonicRoute.ico"
        Width="920" Height="620"
        MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ThemeControls.xaml"/><ResourceDictionary Source="SettingsControls.xaml"/></ResourceDictionary.MergedDictionaries>
        <!-- bool → 可见性（禁用自动切换状态点） -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 左导航项 -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Viewbox Width="19" Height="19" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Path x:Name="NavGlyph" Width="24" Height="24" Stroke="{DynamicResource Theme.TextSecondary}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Viewbox>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Overview"><Setter TargetName="NavGlyph" Property="Data" Value="{x:Static local:AutomationIcons.Home}"/></Trigger>
                            <Trigger Property="Tag" Value="Apps"><Setter TargetName="NavGlyph" Property="Data" Value="{x:Static local:AutomationIcons.Apps}"/></Trigger>
                            <Trigger Property="Tag" Value="Hotkeys"><Setter TargetName="NavGlyph" Property="Data" Value="{x:Static local:AutomationIcons.Keyboard}"/></Trigger>
                            <Trigger Property="Tag" Value="Theme"><Setter TargetName="NavGlyph" Property="Data" Value="{x:Static local:AutomationIcons.Theme}"/></Trigger>
                            <Trigger Property="Tag" Value="Settings"><Setter TargetName="NavGlyph" Property="Data" Value="{x:Static local:AutomationIcons.Settings}"/></Trigger>
                            <Trigger Property="Tag" Value="Automation"><Setter TargetName="NavGlyph" Property="Data" Value="{x:Static local:AutomationIcons.Automation}"/></Trigger>
                            <Trigger Property="Tag" Value="Experimental"><Setter TargetName="NavGlyph" Property="Data" Value="{x:Static local:AutomationIcons.Experiment}"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.NavHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.NavSelected}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="NavGlyph" Property="Stroke" Value="{DynamicResource Theme.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小节标题 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- 页面大标题 -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- 标题栏按钮 -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.NavHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 通用下拉（圆角 + 选中项强调色，模板见 App.xaml RoundedComboBox） -->
        <Style x:Key="SelCombo" TargetType="ComboBox" BasedOn="{StaticResource RoundedComboBox}">
        </Style>

        <!-- 操作名称在下拉中允许换行，使用同一模板显示选中名称。 -->
        <DataTemplate x:Key="AutoActionTextTemplate">
            <TextBlock Text="{Binding}" MaxWidth="340" TextWrapping="Wrap"/>
        </DataTemplate>

        <!-- 编辑器共用标题、图标和表单标签，不重复定义控件模板。 -->
        <Style x:Key="AutomationSectionIcon" TargetType="ContentControl">
            <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="{DynamicResource Theme.NavSelected}" CornerRadius="24">
                            <Viewbox Margin="8" IsHitTestVisible="False">
                                <Path Width="24" Height="24" Data="{TemplateBinding Content}" Stroke="{DynamicResource Theme.Accent}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AutomationFormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- 自动化应用下拉项：图标 + 名称（AppItem 懒加载图标） -->
        <DataTemplate x:Key="AutoAppItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Grid Width="18" Height="18" Margin="0,0,6,0">
                    <Viewbox>
                        <Path Data="{x:Static local:AutomationIcons.Apps}" Width="24" Height="24" Stroke="{DynamicResource Theme.TextSecondary}" StrokeThickness="1.8">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Viewbox>
                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="AutomationIconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.NavHover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AutomationRuleCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBgAlpha}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="MinHeight" Value="76"/>
            <Setter Property="Margin" Value="0,3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Theme.NavSelected}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                </Trigger>
                <Trigger Property="Tag" Value="active">
                    <Setter Property="Background" Value="{DynamicResource Theme.NavSelected}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AutomationSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="Track" Height="20" CornerRadius="10" Background="{DynamicResource Theme.SliderBg}">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource Theme.OnAccent}"
                                         HorizontalAlignment="Left" Margin="2,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Theme.Accent}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AutomationSearchBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Viewbox Width="16" Height="16" HorizontalAlignment="Left" IsHitTestVisible="False">
                                    <Path Width="24" Height="24" Data="{x:Static local:AutomationIcons.Search}" Stroke="{DynamicResource Theme.TextSecondary}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Placeholder" Grid.Column="1" Visibility="Collapsed" IsHitTestVisible="False"
                                           Text="{Binding [Auto.Search], Source={x:Static local:L10n.Instance}}"
                                           Foreground="{DynamicResource Theme.TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBgAlpha}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- 主按钮 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Theme.OnAccent}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Accent}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.AccentDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮 -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.NavHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设备快速切换按钮（概览） -->
        <Style x:Key="QuickDevButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme.SurfaceBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickDevButtonActive" TargetType="Button" BasedOn="{StaticResource QuickDevButton}">
            <Setter Property="Background" Value="{DynamicResource Theme.Overlay}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 应用项模板（图标 + 名称，用于概览应用切换与列表） -->
        <DataTemplate x:Key="AppItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Grid Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Image Source="{Binding Icon}" Width="18" Height="18"
                           SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <!-- 禁用自动切换的应用：图标右上角主题色 RGB 反色小圆点 -->
                    <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-1,-1,0" Fill="{Binding DotBrush}"
                             Visibility="{Binding IsAutoSwitchDisabled, Converter={StaticResource BoolToVis}}"
                             ToolTip="已禁用自动切换"/>
                </Grid>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="13"
                           TextTrimming="CharacterEllipsis" MaxWidth="230"/>
            </StackPanel>
        </DataTemplate>
    <Style x:Key="ThemeSettingsCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="ThemePositionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="ContentTemplate"><Setter.Value>
            <DataTemplate>
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Path Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Width="24" Height="24" Stroke="{DynamicResource Theme.TextPrimary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Viewbox>
                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="105" VerticalAlignment="Center"/>
                </Grid>
            </DataTemplate>
        </Setter.Value></Setter>
    </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- 阴影只处理背景壳，页面内容和动画不进入阴影效果的输入。 -->
        <Border x:Name="WindowShadow"
                Background="{DynamicResource Theme.WindowBgAlpha}"
                BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="10"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
            </Border.Effect>
        </Border>
    <Border x:Name="RootBorder" BorderThickness="1" CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ======================= 标题栏 ======================= -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderTitleText" Text="🎧 音跃 SonicRoute"
                           FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.TextPrimary}"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           MouseLeftButtonDown="Titlebar_MouseDown"
                           ToolTip="拖动移动窗口"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Content="─" Style="{StaticResource TitleBarButton}" Click="TitlebarMin_Click" ToolTip="最小化"/>
                    <Button Content="□" Style="{StaticResource TitleBarButton}" Click="TitlebarMax_Click" ToolTip="最大化 / 还原"/>
                    <Button Content="✕" Style="{StaticResource TitleCloseButton}" Click="TitlebarClose_Click" ToolTip="关闭"/>
                </StackPanel>
            </Grid>

            <!-- ======================= 主体 ======================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

        <!-- ======================= 左侧导航 ======================= -->
        <Border Grid.Column="0"
                Background="Transparent"
                BorderBrush="{DynamicResource Theme.Border}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="14,20,14,16">
                <RadioButton x:Name="NavOverview" GroupName="Nav" Style="{StaticResource NavItem}"
                             Content="{Binding [Nav.Overview], Source={x:Static local:L10n.Instance}}"
                             IsChecked="True" Checked="Nav_Checked" Tag="Overview"/>
                <RadioButton x:Name="NavApps" GroupName="Nav" Style="{StaticResource NavItem}"
                             Content="{Binding [Nav.Apps], Source={x:Static local:L10n.Instance}}"
                             Checked="Nav_Checked" Tag="Apps"/>
                <RadioButton x:Name="NavHotkeys" GroupName="Nav" Style="{StaticResource NavItem}"
                             Content="{Binding [Nav.Hotkeys], Source={x:Static local:L10n.Instance}}"
                             Checked="Nav_Checked" Tag="Hotkeys"/>
                <RadioButton x:Name="NavTheme" GroupName="Nav" Style="{StaticResource NavItem}"
                             Content="{Binding [Nav.Theme], Source={x:Static local:L10n.Instance}}"
                             Checked="Nav_Checked" Tag="Theme"/>
                <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavItem}"
                             Content="{Binding [Nav.Settings], Source={x:Static local:L10n.Instance}}"
                             Checked="Nav_Checked" Tag="Settings"/>
                <RadioButton x:Name="NavAutomation" GroupName="Nav" Style="{StaticResource NavItem}"
                    Content="{Binding [Nav.Automation], Source={x:Static local:L10n.Instance}}"
                    Checked="Nav_Checked" Tag="Automation"/>
                <RadioButton x:Name="NavExperimental" GroupName="Nav" Style="{StaticResource NavItem}"

                             Content="{Binding [Nav.Experimental], Source={x:Static local:L10n.Instance}}"
                             Checked="Nav_Checked" Tag="Experimental" Visibility="Collapsed"
                             Margin="0,6,0,0"/>

            </StackPanel>
        </Border>

        <!-- ======================= 内容区 ======================= -->
        <Grid Grid.Column="1" Margin="26,20,26,20">
            <!-- 概览 -->
            <Grid x:Name="OverviewPage">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                <!-- 当前应用（可切换） -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding [Ov.CurrentApp], Source={x:Static local:L10n.Instance}}"
                                   Style="{StaticResource SectionTitle}"/>
                        <ComboBox x:Name="OverviewAppCombo" Style="{StaticResource SelCombo}"
                                  ItemTemplate="{StaticResource AppItemTemplate}"
                                  SelectionChanged="OverviewAppCombo_SelectionChanged"/>
                        <TextBlock x:Name="OverviewAppPidText" Text=""
                                   FontSize="11.5" Foreground="{DynamicResource Theme.TextSecondary}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 输出设备 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding [Ov.Output], Source={x:Static local:L10n.Instance}}"
                                   Style="{StaticResource SectionTitle}"/>
                        <DockPanel Margin="0,0,0,8">
                            <ComboBox x:Name="OverviewOutputCombo" DockPanel.Dock="Left"
                                      Width="320" Style="{StaticResource SelCombo}" DisplayMemberPath="DisplayLabel"
                                      SelectionChanged="OverviewOutputCombo_SelectionChanged"/>
                            <TextBlock x:Name="OverviewOutputCurrentText" Text=""
                                       FontSize="12" Foreground="{DynamicResource Theme.TextSecondary}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <ItemsControl x:Name="OverviewOutputQuickPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 输入设备（麦克风）：仅实验模式 + 麦克风选项开启时显示，与输出一致可切换/快捷切换 -->
                <Border x:Name="OverviewInputCard" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{Binding [Ov.Input], Source={x:Static local:L10n.Instance}}"
                                   Style="{StaticResource SectionTitle}"/>
                        <DockPanel Margin="0,0,0,8">
                            <ComboBox x:Name="OverviewInputCombo" DockPanel.Dock="Left"
                                      Width="320" Style="{StaticResource SelCombo}" DisplayMemberPath="DisplayLabel"
                                      SelectionChanged="OverviewInputCombo_SelectionChanged"/>
                            <TextBlock x:Name="OverviewInputCurrentText" Text=""
                                       FontSize="12" Foreground="{DynamicResource Theme.TextSecondary}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <ItemsControl x:Name="OverviewInputQuickPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 音量 + 应用 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding [Ov.Volume], Source={x:Static local:L10n.Instance}}"
                                   Style="{StaticResource SectionTitle}"/>
                        <DockPanel Margin="0,0,0,4" MouseWheel="OverviewVolume_MouseWheel">
                            <Button x:Name="OverviewMinus" Content="−" Style="{StaticResource GhostButton}"
                                    Width="34" Padding="0" DockPanel.Dock="Left" Margin="0,0,8,0" Click="OverviewMinus_Click"/>
                            <Button x:Name="OverviewPlus" Content="+" Style="{StaticResource GhostButton}"
                                    Width="34" Padding="0" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OverviewPlus_Click"/>
                            <TextBlock x:Name="OverviewVolumeText" Text="0%"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.TextPrimary}"
                                       DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Slider x:Name="OverviewVolumeSlider" Minimum="0" Maximum="100"
                                    VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                    ValueChanged="OverviewVolumeSlider_ValueChanged"/>
                        </DockPanel>
                        <DockPanel Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button x:Name="OverviewMuteButton"
                                        Content="{Binding [Ov.Mute], Source={x:Static local:L10n.Instance}}"
                                        Style="{StaticResource GhostButton}" Width="96" Margin="0,0,8,0"
                                        Click="OverviewMuteButton_Click"/>
                                <Button x:Name="OverviewMicMuteButton"
                                        Content="{Binding [Ov.MuteMic], Source={x:Static local:L10n.Instance}}"
                                        Style="{StaticResource GhostButton}" MinWidth="140"
                                        Click="OverviewMicMuteButton_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="OverviewStatusText" Text=""
                                       FontSize="11.5" Foreground="{DynamicResource Theme.TextSecondary}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 应用 -->
            <Grid x:Name="AppsPage" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="10">
                    <DockPanel>
                        <Button x:Name="AppsRefreshButton" DockPanel.Dock="Bottom"
                                Content="{Binding [Apps.Refresh], Source={x:Static local:L10n.Instance}}"
                                Style="{StaticResource GhostButton}" Margin="0,10,0,0" Click="AppsRefreshButton_Click"/>
                        <TextBlock Text="{Binding [Apps.Title], Source={x:Static local:L10n.Instance}}"
                                   Style="{StaticResource SectionTitle}" DockPanel.Dock="Top"/>
                        <ListBox x:Name="AppsListBox" BorderThickness="0" Background="Transparent"
                                 FontSize="13" ItemTemplate="{StaticResource AppItemTemplate}"
                                 ItemContainerStyle="{StaticResource RoundedListBoxItem}"
                                 SelectionChanged="AppsListBox_SelectionChanged">
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="AppsDetailTitle"
                                   Text="{Binding [Apps.SelectHint], Source={x:Static local:L10n.Instance}}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,4"/>
                        <TextBox x:Name="AppsRenameBox" FontSize="12.5"
                                 VerticalContentAlignment="Center" Padding="8,4"
                                 TextChanged="AppsRenameBox_TextChanged"/>
                        <TextBlock Text="{Binding [Apps.RenameHint], Source={x:Static local:L10n.Instance}}"
                                   FontSize="11" Foreground="{DynamicResource Theme.TextSecondary}"
                                   Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <TextBlock x:Name="AppsDetailPid" Text=""
                                   FontSize="11.5" Foreground="{DynamicResource Theme.TextSecondary}"
                                   Margin="0,0,0,14"/>
                        <TextBlock Text="{Binding [Apps.Output], Source={x:Static local:L10n.Instance}}"
                                   Style="{StaticResource SectionTitle}"/>
                        <ComboBox x:Name="AppsOutputCombo" Style="{StaticResource SelCombo}"
                                  Margin="0,0,0,16" DisplayMemberPath="DisplayLabel"
                                  SelectionChanged="AppsOutputCombo_SelectionChanged"/>
                        <TextBlock x:Name="AppsInputLabel"
                                   Text="{Binding [Apps.Input], Source={x:Static local:L10n.Instance}}"
                                   Style="{StaticResource SectionTitle}" Visibility="Collapsed"/>
                        <ComboBox x:Name="AppsInputCombo" Style="{StaticResource SelCombo}"
                                  Margin="0,0,0,16" DisplayMemberPath="DisplayLabel"
                                  SelectionChanged="AppsInputCombo_SelectionChanged" Visibility="Collapsed"/>
                        <TextBlock Text="{Binding [Apps.Volume], Source={x:Static local:L10n.Instance}}"
                                   Style="{StaticResource SectionTitle}"/>
                        <DockPanel Margin="0,0,0,10" MouseWheel="AppsVolume_MouseWheel">
                            <Button x:Name="AppsMinus" Content="−" Style="{StaticResource GhostButton}"
                                    Width="34" Padding="0" DockPanel.Dock="Left" Margin="0,0,8,0" Click="AppsMinus_Click"/>
                            <Button x:Name="AppsPlus" Content="+" Style="{StaticResource GhostButton}"
                                    Width="34" Padding="0" DockPanel.Dock="Right" Margin="8,0,0,0" Click="AppsPlus_Click"/>
                            <TextBlock x:Name="AppsVolumeText" Text="0%"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.TextPrimary}"
                                       DockPanel.Dock="Right" Width="46" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Slider x:Name="AppsVolumeSlider" Minimum="0" Maximum="100"
                                    VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                    ValueChanged="AppsVolumeSlider_ValueChanged"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <Button x:Name="AppsMuteButton"
                                    Content="{Binding [Apps.Mute], Source={x:Static local:L10n.Instance}}"
                                    Style="{StaticResource GhostButton}" Width="96"
                                    Click="AppsMuteButton_Click"/>
                            <Button x:Name="AppsDisableAutoButton"
                                    Content="{Binding [Apps.DisableAuto], Source={x:Static local:L10n.Instance}}"
                                    Style="{StaticResource GhostButton}" MinWidth="132" Margin="8,0,0,0"
                                    Click="AppsDisableAutoButton_Click"/>
                            <Button x:Name="AppsShowInPanelButton"
                                    Content="{Binding [Apps.ShowInPanel], Source={x:Static local:L10n.Instance}}"
                                    Style="{StaticResource GhostButton}" MinWidth="132" Margin="8,0,0,0"
                                    Click="AppsShowInPanelButton_Click"/>
                            <TextBlock x:Name="AppsStatusText" Text=""
                                       FontSize="11.5" Foreground="{DynamicResource Theme.TextSecondary}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 快捷键 -->
            <Grid x:Name="HotkeysPage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding [Hk.Hint], Source={x:Static local:L10n.Instance}}"
                                   FontSize="12" Foreground="{DynamicResource Theme.TextSecondary}"
                                   Margin="0,0,0,16" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ItemsControl x:Name="HotkeyList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 主题 -->
            <Grid x:Name="ThemePage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding [Nav.Theme], Source={x:Static local:L10n.Instance}}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                        <TextBlock Text="{Binding [Th.PageHint], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeHint}" Margin="0,5,0,18"/>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <ContentControl Content="{x:Static local:AutomationIcons.Palette}" Style="{StaticResource AutomationSectionIcon}" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding [St.ThemeMode], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeSectionTitle}"/>
                                        <TextBlock Text="{Binding [Th.ModeHint], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeHint}"/>
                                    </StackPanel>
                                </DockPanel>
                                <WrapPanel Margin="0,0,-6,2">
                                    <RadioButton x:Name="ThemeSystem" Style="{StaticResource ThemeChoice}" GroupName="ThemeMode" Tag="system" Checked="Theme_Changed" Content="{Binding [St.ThemeSystem], Source={x:Static local:L10n.Instance}}"/>
                                    <RadioButton x:Name="ThemeLight" Style="{StaticResource ThemeChoice}" GroupName="ThemeMode" Tag="light" Checked="Theme_Changed" Content="{Binding [St.ThemeLight], Source={x:Static local:L10n.Instance}}"/>
                                    <RadioButton x:Name="ThemeDark" Style="{StaticResource ThemeChoice}" GroupName="ThemeMode" Tag="dark" Checked="Theme_Changed" Content="{Binding [St.ThemeDark], Source={x:Static local:L10n.Instance}}"/>
                                </WrapPanel>
                                <Border BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="11" Padding="14,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*" MinWidth="130"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding [Th.CustomTitle], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeSectionTitle}" FontSize="13.5"/>
                                                <TextBlock Text="{Binding [Th.CustomHint], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeHint}"/>
                                                <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                                                    <Border x:Name="ThemeColorPreview" Width="54" Height="54" CornerRadius="8" Background="#2F80ED" Margin="0,0,10,6"/>
                                                    <TextBox x:Name="ThemeColorHex" Text="#2F80ED" FontFamily="Consolas" FontSize="12" Width="90" Height="34" Margin="0,0,8,6" VerticalAlignment="Center"
                                                             AutomationProperties.Name="{Binding [Th.CustomTitle], Source={x:Static local:L10n.Instance}}" LostFocus="ThemeHex_LostFocus" PreviewKeyDown="ThemeHex_PreviewKeyDown"/>
                                                    <Button x:Name="ThemeChooseColor" Style="{StaticResource GhostButton}" Height="34" Margin="0,0,0,6" Click="ThemeChooseColor_Click" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Margin="9,0">
                                                            <Viewbox Width="15" Height="15" Margin="0,0,6,0"><Path Data="{x:Static local:AutomationIcons.Theme}" Width="24" Height="24" Stroke="{DynamicResource Theme.TextSecondary}" StrokeThickness="1.8"/></Viewbox>
                                                            <TextBlock Text="{Binding [Th.ChooseColor], Source={x:Static local:L10n.Instance}}" FontSize="12" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                            <ContentControl Grid.Column="2" ContentTemplate="{StaticResource ThemePreview}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <ContentControl Content="{x:Static local:AutomationIcons.Transparency}" Style="{StaticResource AutomationSectionIcon}" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding [St.Opacity], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeSectionTitle}"/>
                                        <TextBlock Text="{Binding [Th.OpacityHint], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeHint}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="36,0,0,0">
                                    <Border Background="{DynamicResource Theme.SurfaceAlt}" CornerRadius="12" Width="58" Height="34" DockPanel.Dock="Right" Margin="14,0,0,0">
                                        <TextBlock x:Name="OpacityText" Text="85%" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" IsMoveToPointEnabled="True" ValueChanged="OpacitySlider_ValueChanged" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="{Binding [St.OpacityHint], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeHint}" Margin="36,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- OSD 外观：共享图标标题、位置按钮和三列参数行。 -->
                        <Border Style="{StaticResource ThemeSettingsCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ContentControl Style="{StaticResource ThemeCardHeader}" Tag="{x:Static local:AutomationIcons.Monitor}" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [Theme.OsdAppearanceSettings], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeSectionTitle}" FontSize="16" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding [Th.OsdHint], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeHint}"/>
                                        </StackPanel>
                                    </ContentControl>
                                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="320">
                                        <Button x:Name="OsdAdjustBtnTheme" Content="{Binding [Exp.OsdAdjust], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemePositionButton}" Tag="{x:Static local:AutomationIcons.Position}" Margin="0,0,8,0" Click="OsdAdjust_Click" ToolTip="{Binding [Exp.OsdAdjustHint], Source={x:Static local:L10n.Instance}}"/>
                                        <Button x:Name="OsdResetButtonTheme" Content="{Binding [Exp.OsdReset], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemePositionButton}" Tag="{x:Static local:AutomationIcons.Reset}" Click="OsdReset_Click"/>
                                    </WrapPanel>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Theme.Border}" Margin="0,16,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{Binding [Theme.OsdVolumeVisual], Source={x:Static local:L10n.Instance}}" FontSize="13.5" Foreground="{DynamicResource Theme.TextPrimary}"/>
                                        <TextBlock Text="{Binding [Theme.OsdVolumeVisualHint], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeHint}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="OsdVolumeVisualCheck" Grid.Column="1" Style="{StaticResource AutomationSwitch}" Width="34" VerticalAlignment="Center" AutomationProperties.Name="{Binding [Theme.OsdVolumeVisual], Source={x:Static local:L10n.Instance}}" Checked="OsdVolumeVisual_Changed" Unchecked="OsdVolumeVisual_Changed"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Theme.Border}" Margin="0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [Theme.MicMuteOsdPersist], Source={x:Static local:L10n.Instance}}" FontSize="13.5" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <CheckBox x:Name="MicMutePersistCheck" Grid.Column="1" Style="{StaticResource AutomationSwitch}" Width="34" VerticalAlignment="Center" AutomationProperties.Name="{Binding [Theme.MicMuteOsdPersist], Source={x:Static local:L10n.Instance}}" Checked="MicMutePersist_Changed" Unchecked="MicMutePersist_Changed"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Theme.Border}" Margin="0,14,0,10"/>
                                <ToggleButton x:Name="OsdMoreToggle" Style="{StaticResource MoreOptionsToggle}" Content="{Binding [Exp.MoreOptions], Source={x:Static local:L10n.Instance}}" Checked="OsdMoreToggle_Click" Unchecked="OsdMoreToggle_Click"/>
                                <local:AnimatedExpandHost>
                                    <StackPanel x:Name="OsdSlidersPanel" Margin="8,10,0,0" Visibility="Collapsed">
                                        <CheckBox x:Name="MicMuteTrackInputCheck" Content="{Binding [Theme.MicMuteTrackInput], Source={x:Static local:L10n.Instance}}" FontSize="12.5" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,10" Visibility="Collapsed" Checked="MicMuteTrackInput_Changed" Unchecked="MicMuteTrackInput_Changed"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                                            <TextBlock Text="{Binding [Exp.OsdWidthLabel], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeSliderLabel}"/>
                                            <Slider x:Name="OsdWidthSlider" Grid.Column="1" Minimum="180" Maximum="600" Value="240" Margin="8,0,16,0" VerticalAlignment="Center" ValueChanged="OsdWidthSlider_ValueChanged"/>
                                            <TextBlock x:Name="OsdWidthValue" Grid.Column="2" Style="{StaticResource ThemeSliderValue}"/>
                                            <TextBlock Grid.Row="1" Text="{Binding [Exp.OsdFontLabel], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeSliderLabel}"/>
                                            <Slider x:Name="OsdFontSlider" Grid.Row="1" Grid.Column="1" Minimum="0.7" Maximum="2.0" Value="1.0" SmallChange="0.05" LargeChange="0.1" Margin="8,0,16,0" VerticalAlignment="Center" ValueChanged="OsdFontSlider_ValueChanged"/>
                                            <TextBlock x:Name="OsdFontValue" Grid.Row="1" Grid.Column="2" Style="{StaticResource ThemeSliderValue}"/>
                                            <TextBlock Grid.Row="2" Text="{Binding [Exp.OsdFadeInLabel], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeSliderLabel}"/>
                                            <Slider x:Name="OsdFadeInSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="500" Value="100" IsSnapToTickEnabled="True" TickFrequency="10" SmallChange="10" LargeChange="50" Margin="8,0,16,0" VerticalAlignment="Center" ValueChanged="OsdFadeInSlider_ValueChanged"/>
                                            <TextBlock x:Name="OsdFadeInValue" Grid.Row="2" Grid.Column="2" Style="{StaticResource ThemeSliderValue}"/>
                                            <TextBlock Grid.Row="3" Text="{Binding [Exp.OsdFadeOutLabel], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeSliderLabel}"/>
                                            <Slider x:Name="OsdFadeOutSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1000" Value="200" IsSnapToTickEnabled="True" TickFrequency="50" SmallChange="50" LargeChange="100" Margin="8,0,16,0" VerticalAlignment="Center" ValueChanged="OsdFadeOutSlider_ValueChanged"/>
                                            <TextBlock x:Name="OsdFadeOutValue" Grid.Row="3" Grid.Column="2" Style="{StaticResource ThemeSliderValue}"/>
                                        </Grid>
                                    </StackPanel>
                                </local:AnimatedExpandHost>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ThemeSettingsCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ContentControl Style="{StaticResource ThemeCardHeader}" Tag="{x:Static local:AutomationIcons.Application}" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [Exp.PanelPosSection], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeSectionTitle}" FontSize="16" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding [Th.PanelHint], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeHint}"/>
                                        </StackPanel>
                                    </ContentControl>
                                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="320">
                                        <Button x:Name="PanelPosAdjustBtn" Content="{Binding [Exp.PanelPosAdjust], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemePositionButton}" Tag="{x:Static local:AutomationIcons.Position}" Margin="0,0,8,0" Click="PanelPosAdjust_Click"/>
                                        <Button x:Name="PanelPosResetBtn" Content="{Binding [Exp.PanelPosReset], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemePositionButton}" Tag="{x:Static local:AutomationIcons.Reset}" Click="PanelPosReset_Click"/>
                                    </WrapPanel>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Theme.Border}" Margin="0,16,0,12"/>
                                <TextBlock Text="{Binding [Exp.PanelPosHint2], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeHint}" Margin="0,0,0,8"/>
                                <StackPanel x:Name="PanelHeightSection">
                                    <Grid Margin="8,2,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding [Exp.PanelHeight], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeSliderLabel}"/>
                                        <Slider x:Name="PanelHeightSlider" Grid.Column="1" Minimum="350" Maximum="800" Value="450" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0,16,0" ValueChanged="PanelHeightSlider_Changed"/>
                                        <TextBlock x:Name="PanelHeightValue" Grid.Column="2" Text="450 px" Style="{StaticResource ThemeSliderValue}"/>
                                    </Grid>
                                    <CheckBox x:Name="AppPeakMeterCheck" Content="{Binding [Theme.AppPeakMeter], Source={x:Static local:L10n.Instance}}" FontSize="12.5" Foreground="{DynamicResource Theme.TextPrimary}" Margin="8,16,0,0" Checked="AppPeakMeter_Changed" Unchecked="AppPeakMeter_Changed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 设置 -->
            <Grid x:Name="SettingsPage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding [St.Settings], Source={x:Static local:L10n.Instance}}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                        <TextBlock Text="{Binding [Settings.PageHint], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeHint}" Margin="0,5,0,18"/>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel>
                                    <ToggleButton x:Name="KeepDevicesMoreToggle" Style="{StaticResource MoreOptionsToggle}" DockPanel.Dock="Right" Content="{Binding [Exp.MoreOptions], Source={x:Static local:L10n.Instance}}" Visibility="Collapsed" VerticalAlignment="Top" Click="KeepDevicesMoreToggle_Click"/>
                                    <StackPanel><ContentControl Style="{StaticResource SettingsSectionHeader}" Tag="{x:Static local:AutomationIcons.Monitor}" Content="{Binding [Settings.KeepTitle], Source={x:Static local:L10n.Instance}}"/><TextBlock Style="{StaticResource ThemeHint}" Margin="32,0,0,10" Text="{Binding [Settings.KeepHint], Source={x:Static local:L10n.Instance}}"/></StackPanel>
                                </DockPanel>
                                <local:AnimatedExpandHost>
                                    <StackPanel x:Name="KeepDevicesBody" Margin="0,8,0,0">
                                        <DockPanel Margin="0,0,0,8">
                                            <Button x:Name="SelectAllOutputButton" DockPanel.Dock="Right" Content="{Binding [St.SelectAll], Source={x:Static local:L10n.Instance}}" Style="{StaticResource GhostButton}" Height="26" Padding="12,0" FontSize="11.5" Click="SelectAllOutput_Click"/>
