                                    <RadioButton x:Name="DefaultAppRecent" Grid.Column="0" Style="{StaticResource SettingsAppChoice}" GroupName="DefaultApp" Tag="recent" Checked="DefaultAppMode_Changed"><StackPanel><TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding [St.DefaultAppRecent], Source={x:Static local:L10n.Instance}}"/><TextBlock Style="{StaticResource ThemeHint}" FontSize="10" Text="{Binding [Settings.RecentHint], Source={x:Static local:L10n.Instance}}"/></StackPanel></RadioButton>
                                    <RadioButton x:Name="DefaultAppLast" Grid.Column="1" Style="{StaticResource SettingsAppChoice}" GroupName="DefaultApp" Tag="last" Checked="DefaultAppMode_Changed"><StackPanel><TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding [St.DefaultAppLast], Source={x:Static local:L10n.Instance}}"/><TextBlock Style="{StaticResource ThemeHint}" FontSize="10" Text="{Binding [Settings.LastHint], Source={x:Static local:L10n.Instance}}"/></StackPanel></RadioButton>
                                    <RadioButton x:Name="DefaultAppFixed" Grid.Column="2" Style="{StaticResource SettingsAppChoice}" GroupName="DefaultApp" Tag="fixed" Checked="DefaultAppMode_Changed"><StackPanel><TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding [St.DefaultAppFixed], Source={x:Static local:L10n.Instance}}"/><TextBlock Style="{StaticResource ThemeHint}" FontSize="10" Text="{Binding [Settings.FixedHint], Source={x:Static local:L10n.Instance}}"/></StackPanel></RadioButton>
                                </Grid>
                                <ComboBox x:Name="FixedAppCombo" Style="{StaticResource SelCombo}" ItemTemplate="{StaticResource AppItemTemplate}" Margin="0,0,0,2" SelectionChanged="FixedAppCombo_SelectionChanged"/>
                                <TextBlock Text="{Binding [St.FixedAppHint], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeHint}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <ContentControl Style="{StaticResource SettingsSectionHeader}" Tag="{x:Static local:AutomationIcons.Settings}" Content="{Binding [St.Misc], Source={x:Static local:L10n.Instance}}"/>
                                <CheckBox x:Name="SettingsStartMinimized" Style="{StaticResource SettingsSwitchRow}" Tag="{x:Static local:AutomationIcons.Monitor}" Checked="SettingsStartMinimized_Changed" Unchecked="SettingsStartMinimized_Changed"><StackPanel><TextBlock Text="{Binding [St.StartMinimized], Source={x:Static local:L10n.Instance}}" TextWrapping="Wrap"/><TextBlock Style="{StaticResource ThemeHint}" Text="{Binding [Settings.StartMinimizedHint], Source={x:Static local:L10n.Instance}}" Margin="0,3,0,0"/></StackPanel></CheckBox>
                                <CheckBox x:Name="SettingsAutoStart" Style="{StaticResource SettingsSwitchRow}" Tag="{x:Static local:AutomationIcons.Power}" Checked="SettingsAutoStart_Changed" Unchecked="SettingsAutoStart_Changed"><StackPanel><TextBlock Text="{Binding [St.AutoStart], Source={x:Static local:L10n.Instance}}" TextWrapping="Wrap"/><TextBlock Style="{StaticResource ThemeHint}" Text="{Binding [Settings.AutoStartHint], Source={x:Static local:L10n.Instance}}" Margin="0,3,0,0"/></StackPanel></CheckBox>
                                <ToggleButton x:Name="SettingsMoreToggle" Style="{StaticResource MoreOptionsToggle}" Content="{Binding [Exp.MoreOptions], Source={x:Static local:L10n.Instance}}" Margin="32,6,0,4" Checked="SettingsMoreToggle_Click" Unchecked="SettingsMoreToggle_Click"/>
                                <local:AnimatedExpandHost><StackPanel x:Name="SettingsMorePanel" Visibility="Collapsed" Margin="32,6,0,0">
                                    <Button x:Name="CleanAutoStartBtn" Content="{Binding [St.CleanAutoStart], Source={x:Static local:L10n.Instance}}" Style="{StaticResource GhostButton}" FontSize="12.5" HorizontalAlignment="Left" Click="CleanAutoStart_Click"/>
                                </StackPanel></local:AnimatedExpandHost>
                                <CheckBox x:Name="SettingsShowPanelOnStart" Style="{StaticResource SettingsSwitchRow}" Tag="{x:Static local:AutomationIcons.Application}" Checked="SettingsShowPanelOnStart_Changed" Unchecked="SettingsShowPanelOnStart_Changed"><StackPanel><TextBlock Text="{Binding [St.StartPanel], Source={x:Static local:L10n.Instance}}" TextWrapping="Wrap"/><TextBlock Style="{StaticResource ThemeHint}" Text="{Binding [Settings.StartPanelHint], Source={x:Static local:L10n.Instance}}" Margin="0,3,0,0"/></StackPanel></CheckBox>
                                <Grid Margin="2,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="17" Height="17" HorizontalAlignment="Left"><Path Data="{x:Static local:AutomationIcons.Speaker}" Width="24" Height="24" Stroke="{DynamicResource Theme.TextSecondary}" StrokeThickness="1.8"/></Viewbox>
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="{Binding [St.VolumeStep], Source={x:Static local:L10n.Instance}}" FontSize="12.5" Foreground="{DynamicResource Theme.TextPrimary}"/><TextBlock Text="{Binding [St.VolumeStepHint], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeHint}"/></StackPanel>
                                    <TextBox x:Name="VolumeStepBox" Grid.Column="2" FontSize="12.5" Height="30" VerticalContentAlignment="Center" Padding="6,4" TextAlignment="Center" LostFocus="VolumeStepBox_LostFocus" KeyDown="VolumeStepBox_KeyDown"/>
                                </Grid>
                                <CheckBox x:Name="SettingsTrayWheelEverywhere" Style="{StaticResource SettingsSwitchRow}" Tag="{x:Static local:AutomationIcons.Speaker}" Checked="SettingsTrayWheelEverywhere_Changed" Unchecked="SettingsTrayWheelEverywhere_Changed"><StackPanel><TextBlock Text="{Binding [St.TrayWheelEverywhere], Source={x:Static local:L10n.Instance}}" TextWrapping="Wrap"/><TextBlock Style="{StaticResource ThemeHint}" Text="{Binding [St.TrayWheelEverywhereHint], Source={x:Static local:L10n.Instance}}" Margin="0,3,0,0"/></StackPanel></CheckBox>
                                <CheckBox x:Name="ExpMicOptionCheck" Style="{StaticResource SettingsSwitchRow}" Tag="{x:Static local:AutomationIcons.Microphone}" Checked="ExpMicOption_Changed" Unchecked="ExpMicOption_Changed"><StackPanel><TextBlock Text="{Binding [St.ExperimentalMic], Source={x:Static local:L10n.Instance}}" TextWrapping="Wrap"/><TextBlock Style="{StaticResource ThemeHint}" Text="{Binding [St.ExperimentalMicHint], Source={x:Static local:L10n.Instance}}" Margin="0,3,0,0"/></StackPanel></CheckBox>
                                <ToggleButton x:Name="MicMoreToggle" Style="{StaticResource MoreOptionsToggle}" Content="{Binding [Exp.MoreOptions], Source={x:Static local:L10n.Instance}}" Margin="32,6,0,0" Visibility="Collapsed" Checked="MicMoreToggle_Click" Unchecked="MicMoreToggle_Click"/>
                                <local:AnimatedExpandHost><StackPanel x:Name="MicMorePanel" Margin="32,6,0,0" Visibility="Collapsed">
                                    <CheckBox x:Name="ExpMicPanelCheck" Style="{StaticResource SettingsSwitchRow}" Tag="{x:Static local:AutomationIcons.Microphone}" Checked="ExpMicPanel_Changed" Unchecked="ExpMicPanel_Changed"><StackPanel><TextBlock Text="{Binding [Exp.MicPanel], Source={x:Static local:L10n.Instance}}" TextWrapping="Wrap"/></StackPanel></CheckBox>
                                </StackPanel></local:AnimatedExpandHost>
                                <Grid Margin="2,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="17" Height="17" HorizontalAlignment="Left"><Path Data="{x:Static local:AutomationIcons.Monitor}" Width="24" Height="24" Stroke="{DynamicResource Theme.TextSecondary}" StrokeThickness="1.8"/></Viewbox>
                                    <TextBlock Grid.Column="1" Text="{Binding [St.QuickPanelStyle], Source={x:Static local:L10n.Instance}}" FontSize="12.5" Foreground="{DynamicResource Theme.TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                    <ComboBox x:Name="QuickPanelStyleCombo" Grid.Column="2" Style="{StaticResource SelCombo}" MinWidth="150" HorizontalAlignment="Left" SelectionChanged="QuickPanelStyleCombo_Changed"/>
                                </Grid>
                                <StackPanel x:Name="PanelChangeSysDefSection">
                                    <CheckBox x:Name="SettingsPanelChangeSysDef" Style="{StaticResource SettingsSwitchRow}" Tag="{x:Static local:AutomationIcons.Switch}" Checked="SettingsPanelChangeSysDef_Changed" Unchecked="SettingsPanelChangeSysDef_Changed"><StackPanel><TextBlock Text="{Binding [St.PanelChangeSystemDefault], Source={x:Static local:L10n.Instance}}" TextWrapping="Wrap"/><TextBlock Style="{StaticResource ThemeHint}" Text="{Binding [St.PanelChangeSystemDefaultHint], Source={x:Static local:L10n.Instance}}" Margin="0,3,0,0"/></StackPanel></CheckBox>
                                </StackPanel>
                                <CheckBox x:Name="ExpCollapseCheck" Style="{StaticResource SettingsSwitchRow}" Tag="{x:Static local:AutomationIcons.Options}" Checked="ExpCollapse_Changed" Unchecked="ExpCollapse_Changed"><StackPanel><TextBlock Text="{Binding [Exp.Collapse], Source={x:Static local:L10n.Instance}}" TextWrapping="Wrap"/><TextBlock Style="{StaticResource ThemeHint}" Text="{Binding [Exp.CollapseHint], Source={x:Static local:L10n.Instance}}" Margin="0,3,0,0"/></StackPanel></CheckBox>
                                <CheckBox x:Name="SettingsExperimentalMode" Style="{StaticResource SettingsSwitchRow}" Tag="{x:Static local:AutomationIcons.Experiment}" Visibility="Collapsed" Checked="SettingsExperimentalMode_Changed" Unchecked="SettingsExperimentalMode_Changed">
                                    <StackPanel><TextBlock Text="{Binding [St.ExperimentalMode], Source={x:Static local:L10n.Instance}}" TextWrapping="Wrap"/><TextBlock x:Name="ExperimentalModeHint" Text="{Binding [St.ExperimentalModeHint], Source={x:Static local:L10n.Instance}}" Style="{StaticResource ThemeHint}" Visibility="Collapsed"/></StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                        <!-- 语言（置于作者名上方）：语言下拉 + 语言文件管理（导出/导入/打开/还原） -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <ContentControl Style="{StaticResource SettingsSectionHeader}" Tag="{x:Static local:AutomationIcons.Message}" Content="{Binding [St.Language], Source={x:Static local:L10n.Instance}}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="LangCombo" Style="{StaticResource SelCombo}"
                                              MaxWidth="240" MinWidth="200" VerticalAlignment="Center"
                                              SelectionChanged="Language_SelectionChanged"/>
                                    <ToggleButton x:Name="LangMoreToggle" Style="{StaticResource MoreOptionsToggle}" Content="{Binding [Exp.MoreOptions], Source={x:Static local:L10n.Instance}}"
                                                  Margin="12,0,0,0" VerticalAlignment="Center"
                                                  Checked="LangMoreToggle_Click" Unchecked="LangMoreToggle_Click"/>
                                </StackPanel>
                                <!-- 语言文件管理（折叠）：导出/导入/打开语言文件夹/还原默认语言 -->
                                <local:AnimatedExpandHost>
                                    <StackPanel x:Name="LangMorePanel" Margin="0,10,0,0" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="ExpExportLangButton" Content="{Binding [Exp.ExportLang], Source={x:Static local:L10n.Instance}}"
                                                    Style="{StaticResource GhostButton}" Height="34" Padding="14,0"
                                                    Margin="0,0,8,0" HorizontalAlignment="Left" Click="ExpExportLang_Click"/>
                                            <Button x:Name="ExpImportLangButton" Content="{Binding [Exp.ImportLang], Source={x:Static local:L10n.Instance}}"
                                                    Style="{StaticResource GhostButton}" Height="34" Padding="14,0"
                                                    Margin="0,0,8,0" HorizontalAlignment="Left" Click="ExpImportLang_Click"
                                                    AllowDrop="True" DragOver="ExpImportLangButton_DragOver" Drop="ExpImportLangButton_Drop"/>
                                            <Button x:Name="ExpOpenLangDirButton" Content="{Binding [Exp.OpenLangDir], Source={x:Static local:L10n.Instance}}"
                                                    Style="{StaticResource GhostButton}" Height="34" Padding="14,0"
                                                    Margin="0,0,8,0" HorizontalAlignment="Left" Click="ExpOpenLangDir_Click"/>
                                            <Button x:Name="ExpRestoreLangButton" Content="{Binding [Exp.RestoreLang], Source={x:Static local:L10n.Instance}}"
                                                    Style="{StaticResource GhostButton}" Height="34" Padding="14,0"
                                                    HorizontalAlignment="Left" Click="ExpRestoreLang_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </local:AnimatedExpandHost>
                                <!-- 自定义语言管理（方案3）：列出外置目录非内置语言，可改名/删除 -->
                                <StackPanel x:Name="CustomLangSection" Margin="0,12,0,0" Visibility="Collapsed">
                                    <TextBlock Text="{Binding [Exp.CustomLang], Source={x:Static local:L10n.Instance}}"
                                               Style="{StaticResource SectionTitle}" FontSize="12.5"/>
                                    <ContentControl x:Name="CustomLangList"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ⑥ 其他 + 关于 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="AboutAuthorText"
                                           FontSize="11.5" Foreground="{DynamicResource Theme.TextSecondary}"
                                           Margin="0,16,0,0"
                                           Cursor="Hand" ToolTip="{Binding [St.ExpAuthorTip], Source={x:Static local:L10n.Instance}}"
                                           MouseLeftButtonDown="AboutAuthorText_MouseLeftButtonDown">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="[App.About]" Source="{x:Static local:L10n.Instance}"/>
                                            <Binding Source="{x:Static local:App.DisplayVersion}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Margin="0,12,0,0" FontSize="13"
                                           Foreground="{DynamicResource Theme.TextSecondary}">
                                    <Run Text="{Binding [St.AuthorHome], Mode=OneWay, Source={x:Static local:L10n.Instance}}"/>
                                    <Hyperlink x:Name="BiliLink" Click="BiliLink_Click"
                                               Foreground="{DynamicResource Theme.Accent}">
                                        <Run Text="哔哩哔哩"/>
                                    </Hyperlink>
                                    <Run Text=" ‖ "/>
                                    <Hyperlink x:Name="IfdianLink" Click="IfdianLink_Click"
                                               Foreground="{DynamicResource Theme.Accent}">
                                        <Run Text="爱发电"/>
                                    </Hyperlink>
                                    <Run Text=" ‖ "/>
                                    <Hyperlink x:Name="GithubLink" Click="GithubLink_Click"
                                               Foreground="{DynamicResource Theme.Accent}">
                                        <Run Text="GitHub"/>
                                    </Hyperlink>
                                    <Run Text=" ‖ "/>
                                    <Hyperlink x:Name="CheckUpdateLink" Click="CheckUpdate_Click"
                                               Foreground="{DynamicResource Theme.Accent}">
                                        <Run x:Name="CheckUpdateRun"
                                             Text="{Binding [St.CheckUpdate], Mode=OneWay, Source={x:Static local:L10n.Instance}}"/>
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
