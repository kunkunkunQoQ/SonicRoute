                                      SelectionChanged="AutoFilter_SelectionChanged" Margin="0,0,8,0"/>
                            <Button x:Name="AutoListOptionsButton" Grid.Column="3" Style="{StaticResource GhostButton}" Width="36" Height="36"
                                    ToolTip="{Binding [Auto.ListOptions], Source={x:Static local:L10n.Instance}}"
