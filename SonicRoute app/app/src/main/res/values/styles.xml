<resources>
    <style name="Theme.SonicRoute" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/sonic_background</item>
        <item name="android:navigationBarColor">@color/sonic_surface</item>
        <item name="android:colorAccent">@color/sonic_accent</item>
        <item name="android:colorBackground">@color/sonic_background</item>
        <item name="android:windowBackground">@color/sonic_background</item>
        <item name="android:textColorPrimary">@color/sonic_ink</item>
        <item name="android:textColorSecondary">@color/sonic_secondary</item>
        <item name="android:alertDialogTheme">@style/Theme.SonicRoute.Dialog</item>
    </style>
    <style name="Theme.SonicRoute.Dialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/sonic_accent</item>
        <item name="android:colorBackgroundFloating">@color/sonic_surface</item>
        <item name="android:textColorPrimary">@color/sonic_ink</item>
        <item name="android:textColorSecondary">@color/sonic_secondary</item>
    </style>
    <style name="SonicRoute" />
    <style name="SonicRoute.Title">
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/sonic_ink</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:accessibilityHeading">true</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
    <style name="SonicRoute.SectionTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/sonic_ink</item>
    </style>
    <style name="SonicRoute.Column">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="SonicRoute.Heading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/sonic_ink</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <style name="SonicRoute.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/sonic_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:layout_marginTop">3dp</item>
    </style>
    <style name="SonicRoute.BackendButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">@drawable/row_surface</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/action_ink</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/row_icon</item>
    </style>
    <style name="SonicRoute.ActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:background">@drawable/row_surface</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/sonic_accent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/sonic_accent</item>
    </style>
    <style name="SonicRoute.Primary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:background">@drawable/primary_action</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:drawablePadding">7dp</item>
        <item name="android:drawableTint">@android:color/white</item>
    </style>
    <style name="SonicRoute.ConnectionAction" parent="SonicRoute.ActionButton">
        <item name="android:background">@drawable/connection_action</item>
        <item name="android:textColor">@color/connection_action_ink</item>
    </style>
    <style name="SonicRoute.RowDetail">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/sonic_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="SonicRoute.Switch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:switchPadding">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/sonic_ink</item>
    </style>
    <style name="SonicRoute.Tab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">62dp</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/navigation_tab</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">1dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">@color/nav_ink</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/nav_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="SonicRoute.Notice">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/notice_panel</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:visibility">gone</item>
    </style>
    <dimen name="screen_padding">20dp</dimen>
    <dimen name="row_spacing">6dp</dimen>
    <dimen name="touch_min_height">48dp</dimen>
</resources>
