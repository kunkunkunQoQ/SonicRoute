<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout style="@style/SonicRoute.Column" android:paddingHorizontal="@dimen/screen_padding" android:focusableInTouchMode="true">
        <TextView style="@style/SonicRoute.Heading" android:labelFor="@id/route_app_search" android:text="@string/native_route_app" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <EditText android:id="@+id/route_app_search" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min_height" android:hint="@string/route_search_hint" android:textSize="15sp" android:inputType="textFilter|textNoSuggestions" android:maxLength="160"
                android:imeOptions="actionSearch" android:singleLine="true" android:importantForAutofill="no" />
            <ImageButton android:id="@+id/route_search_clear" android:layout_width="@dimen/touch_min_height" android:layout_height="@dimen/touch_min_height"
                android:src="@drawable/ic_clear" android:background="@drawable/row_surface" android:tint="@color/row_icon"
                android:contentDescription="@string/route_search_clear" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/route_search_empty" style="@style/SonicRoute.Body" android:text="@string/route_search_empty" android:visibility="gone" android:accessibilityLiveRegion="polite" />
        <Spinner android:id="@+id/route_app" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min_height" android:contentDescription="@string/native_route_app" />
        <TextView style="@style/SonicRoute.Heading" android:labelFor="@id/route_output" android:text="@string/native_route_output" />
        <Spinner android:id="@+id/route_output" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min_height" />
        <TextView android:id="@+id/route_result" style="@style/SonicRoute.Body" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/route_permissions" style="@style/SonicRoute.ActionButton" android:text="@string/choose_permissions" android:visibility="gone" />
        <Button android:id="@+id/route_rule_save" style="@style/SonicRoute.BackendButton" android:text="@string/native_rule_save" />
        <LinearLayout android:id="@+id/route_rule_controls" style="@style/SonicRoute.Column" android:visibility="gone">
            <TextView style="@style/SonicRoute.Heading" android:labelFor="@id/route_rules_list" android:text="@string/native_rule_title" />
            <Spinner android:id="@+id/route_rules_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min_height" />
            <Button android:id="@+id/route_rule_use" style="@style/SonicRoute.BackendButton" android:text="@string/native_rule_use" />
            <Button android:id="@+id/route_rule_delete" style="@style/SonicRoute.BackendButton" android:text="@string/native_rule_delete" />
        </LinearLayout>
        <Button android:id="@+id/route_vendor_volume" style="@style/SonicRoute.BackendButton"
            android:text="@string/native_route_vendor_volume" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
