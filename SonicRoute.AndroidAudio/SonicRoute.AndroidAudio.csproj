<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Preserve the app's selected RID when MSBuild resolves this project reference. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == ''">x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);SONICROUTE_NATIVE_LOOPBACK</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Native/Audio/Audio.csproj" />
    <PackageReference Include="Concentus" Version="2.2.2" GeneratePathProperty="true" />
    <EmbeddedResource Include="$(PkgConcentus)/LICENSE" LogicalName="SonicRoute.Licenses.Concentus" />
    <EmbeddedResource Include="AndroidRuntime.files.json" />
    <EmbeddedResource Include="../AndroidRuntime/*" Exclude="../AndroidRuntime/*.txt" LogicalName="SonicRoute.AndroidRuntime.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../AndroidRuntime/VirtualDisplay/phone-icon.png" LogicalName="SonicRoute.AndroidRuntime.VirtualDisplay.phone-icon.png" />
    <EmbeddedResource Include="AirPlay/Compatibility/playfair-tables.dat" LogicalName="SonicRoute.AirPlay.PlayFair.Tables" />
    <EmbeddedResource Include="AirPlay/Compatibility/LICENSE-MIT.txt" LogicalName="SonicRoute.AirPlay.PlayFair.LICENSE-MIT.txt" />
    <EmbeddedResource Include="AirPlay/Compatibility/NOTICE.md" LogicalName="SonicRoute.AirPlay.PlayFair.NOTICE.md" />
    <EmbeddedResource Include="AirPlay/AacEld.NOTICE.md" LogicalName="SonicRoute.AirPlay.AacEld.NOTICE.md" />
    <EmbeddedResource Include="AirPlay/FFmpeg-LGPL-2.1.txt" LogicalName="SonicRoute.AirPlay.AacEld.FFmpeg-LGPL-2.1.txt" />
    <Compile Include="../SonicRoute.Core/AtomicFile.cs" Link="Shared/AtomicFile.cs" />
    <Compile Include="../shared/WindowsAudio/Win32Native.cs" Link="WindowsAudio/Win32Native.cs" />
    <Compile Include="../shared/WindowsAudio/ProcessCaptureIdentity.cs" Link="WindowsAudio/ProcessCaptureIdentity.cs" />
    <Compile Include="../shared/WindowsAudio/PcProcessLoopbackCapture.cs" Link="WindowsAudio/PcProcessLoopbackCapture.cs" />
    <InternalsVisibleTo Include="AndroidAudioChecks" />
    <InternalsVisibleTo Include="FullProbe" />
    <InternalsVisibleTo Include="AndroidUiChecks" />
    <InternalsVisibleTo Include="SonicRoute" />
  </ItemGroup>
</Project>
