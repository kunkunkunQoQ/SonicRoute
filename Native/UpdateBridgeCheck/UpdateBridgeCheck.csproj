<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Target Name="RequireBaseline" BeforeTargets="PrepareForBuild" Condition="!Exists('$(BaselineSource)/SonicRoute/Updates/UpdateProtocol.cs')">
    <Error Text="Pass -p:BaselineSource=path to the unmodified 1.36 checkout." />
  </Target>
  <ItemGroup>
    <Compile Include="$(BaselineSource)/SonicRoute/Updates/UpdateProtocol.cs;$(BaselineSource)/SonicRoute/Updates/UpdateInstaller.cs" />
    <EmbeddedResource Include="$(BaselineSource)/build/FullRelease.files.json" LogicalName="SonicRoute.FullRelease.files.json" Condition="'$(SonicRouteEdition)'=='Full'" />
  </ItemGroup>
</Project>