<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <AssemblyName>SonicRoute.ForegroundProbe</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../SonicRoute/ForegroundChangeSource.cs" Link="Product/ForegroundChangeSource.cs" />
    <Compile Include="../WindowApi.cs" Link="WindowApi.cs" />
    <Compile Include="../../Graphics/DirectDrawing.cs" Link="Graphics/DirectDrawing.cs" />
  </ItemGroup>
</Project>
