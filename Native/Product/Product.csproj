<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>SonicRoute</AssemblyName>
    <RootNamespace>SonicRoute</RootNamespace>
    <AssemblyTitle>SonicRoute</AssemblyTitle>
    <AssemblyTitle Condition="'$(SonicRouteEdition)'=='Lite'">SonicRoute Lite</AssemblyTitle>
    <Product>SonicRoute</Product>
    <Description>SonicRoute .NET 10 Native AOT</Description>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>../../SonicRoute/SonicRoute.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Audio/Audio.csproj" />
    <ProjectReference Include="../../SonicRoute.AndroidAudio/SonicRoute.AndroidAudio.csproj" Condition="'$(SonicRouteEdition)'=='Full'" />
    <Compile Include="../../SonicRoute/AndroidAudioHost.IsolationRules.cs" Condition="'$(SonicRouteEdition)'=='Full'" />
    <PackageReference Include="QRCoder" Version="1.7.0" Condition="'$(SonicRouteEdition)'=='Full'" />
    <Compile Include="../Graphics/DirectDrawing.cs;../../SonicRoute.AndroidAudio/WicIconLoader.cs;../../SonicRoute.AndroidAudio/ComInteropHelpers.cs;../../shared/WindowsAudio/Win32Native.cs" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="SonicRoute.License" />
    <ProjectReference Include="../../SonicRoute.Core/SonicRoute.Core.csproj" />
    <ProjectReference Include="../../StoreInterop/StoreInterop.csproj" />
    <Compile Include="../../SonicRoute/CoalescedVolumeWriter.cs;../../SonicRoute/ForegroundChangeSource.cs;../../SonicRoute/L10n.cs;../../SonicRoute/LanguageFiles.cs;../../SonicRoute/LanguageJsonContext.cs;../../SonicRoute/HostStartup.cs;../../SonicRoute/CommandOutput.cs" />
    <BuiltinLanguage Include="../../SonicRoute/Resources/Lang/*.json" />
    <EmbeddedResource Include="../../SonicRoute/SonicRoute.png" LogicalName="SonicRoute.SonicRoute.png" />
  </ItemGroup>
  <Target Name="PackBuiltinLanguages" Inputs="@(BuiltinLanguage);../../SonicRoute/Resources/Lang;$(MSBuildProjectFullPath)" Outputs="$(IntermediateOutputPath)languages.zip">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ZipDirectory SourceDirectory="../../SonicRoute/Resources/Lang" DestinationFile="$(IntermediateOutputPath)languages.zip" Overwrite="true" />
  </Target>
  <Target Name="EmbedBuiltinLanguages" BeforeTargets="AssignTargetPaths" DependsOnTargets="PackBuiltinLanguages">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)languages.zip" LogicalName="SonicRoute.Resources.Lang.zip" />
    </ItemGroup>
  </Target>
  <Import Project="../../build/Version.targets" />
  <Import Project="Protocol/Protocol.targets" />
  <Import Project="Routing/Routing.targets" />
  <Import Project="Automation/Automation.targets" />
</Project>
