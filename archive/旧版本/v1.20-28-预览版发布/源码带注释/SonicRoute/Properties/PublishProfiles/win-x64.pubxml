<?xml version="1.0" encoding="utf-8"?>
<!--
  音跃 SonicRoute — Windows x64 发布配置（自包含单文件，即现有发布方式）
  用法（RID 必须写在命令行，见下方说明）：
    dotnet publish SonicRoute/SonicRoute.csproj -c Release -r win-x64 -p:PublishProfile=win-x64
  说明：RuntimeIdentifier 故意不写在本文件里——pubxml 的普通属性不会流向 ProjectReference，
        会导致 SonicRoute.Core 与主程序架构不一致（CS8012）。命令行 -r 是全局属性，两个工程都会生效。
        本文件只承载发布选项与输出目录，与 win-arm64.pubxml 保持完全一致的策略。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>..\dist\publish\win-x64\</PublishDir>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
