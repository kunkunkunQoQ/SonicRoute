<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- .NET Framework 4.8 桌面程序：声明目标运行时 -->
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <runtime>
    <!--
      WPF Per-Monitor V2 DPI 支持（.NET Framework 4.6.2+ 必需开关）。
      必须与 app.manifest 的 <dpiAwareness>PerMonitorV2</dpiAwareness> 配合：
      缺少本开关时 WPF 在 DPI 变化后不会重新缩放，多显示器/不同缩放比下
      OSD 与快速面板的定位会偏移。

      实测（窗口级 GetWindowDpiAwarenessContext，2026-09-22）：
        本 Legacy 版 = PER_MONITOR_AWARE_V2
        net8 主版本   = SYSTEM_AWARE（其 exe 内嵌 manifest 无任何 DPI 声明，属既有情况，
                        本阶段按约束未改动 net8；如需提升需给 SonicRoute 单独加 app.manifest）
    -->
    <AppContextSwitchOverrides value="Switch.System.Windows.DoNotScaleForDpiChanges=false" />
  </runtime>
</configuration>
