<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SonicRoute.Core</RootNamespace>
    <AssemblyName>SonicRoute.Core</AssemblyName>
    <!-- 与主工程一致：无 RID 构建保持 x64；带 RID 发布时由 SDK 按 RID 推导（x64 / arm64），不用 AnyCPU 代替 ARM64 -->
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == ''">x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
