<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SonicRoute.BenchmarkLab</AssemblyName>
    <RootNamespace>SonicRoute.BenchmarkLab</RootNamespace>
    <Description>SonicRoute Benchmark Lab - Independent Windows Process Performance Benchmark and A/B Comparison Tool</Description>
    <Version>1.2.0</Version>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Viewer/index.html" LogicalName="BenchmarkViewer.index.html" />
    <EmbeddedResource Include="Viewer/style.css" LogicalName="BenchmarkViewer.style.css" />
    <EmbeddedResource Include="Viewer/data.js" LogicalName="BenchmarkViewer.data.js" />
    <EmbeddedResource Include="Viewer/app.js" LogicalName="BenchmarkViewer.app.js" />
    <EmbeddedResource Include="Viewer/icons.js" LogicalName="BenchmarkViewer.icons.js" />
    <EmbeddedResource Include="Viewer/workspace.js" LogicalName="BenchmarkViewer.workspace.js" />
  </ItemGroup>

</Project>
